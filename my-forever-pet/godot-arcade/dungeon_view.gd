func combat_audio_gesture(id:String,profile:Dictionary)->Vector4:
	var role:String=str(profile.role)
	if AUDIO_ROLE_GESTURES.has(role):return AUDIO_ROLE_GESTURES[role]
	var record:Dictionary=Rules.MOVE_LIBRARY.get(id,Rules.DEV_NATIVE_MOVES.get(id,{}))
	if str(record.get("category",""))=="status":
		match status_finish_kind(record):
			"heal":return Vector4(440,420,3,.12)
			"cleanse":return Vector4(840,620,4,.12)
			"shield":return Vector4(390,90,2,.22)
			"boost":return Vector4(330,540,4,.26)
			"weaken":return Vector4(690,-510,3,.28)
			"exchange":return Vector4(480,280,2,.32)
			"transform":return Vector4(260,680,5,.22)
			"sleep":return Vector4(380,-80,1,.08)
			"confusion":return Vector4(550,-160,5,.36)
			"poison":return Vector4(180,140,4,.46)
			"burn":return Vector4(155,-45,5,.58)
			"paralysis":return Vector4(1350,-470,7,.66)
			"curse":return Vector4(145,-60,3,.40)
			"heart":return Vector4(520,110,2,.14)
			"bind":return Vector4(230,-100,3,.52)
			"weather":return Vector4(320,210,5,.20)
			"trap":return Vector4(510,-260,2,.56)
	if role=="heal":return Vector4(440,420,3,.12)
	if role=="drain":return Vector4(610,-290,3,.25)
	if role.begins_with("support_") or role.begins_with("status_"):
		return Vector4(520,260,2,.18)
	var form:String=combat_audio_form(id,profile)
	match form:
		"fang":return Vector4(240,-120,1,.86)
		"crunch":return Vector4(125,-55,2,.92)
		"pincer":return Vector4(1250,-440,2,.72)
		"punch","thump":return Vector4(145,-65,1,.84)
		"kick":return Vector4(105,-45,1,.78)
		"claw":return Vector4(1150,-700,3,.68)
		"slice":return Vector4(1500,-850,1,.80)
		"detonation","shockwave":return Vector4(90,-40,2,.88)
		"implosion":return Vector4(160,510,1,.30)
		"beam":return Vector4(680,220,2,.25)
		"bubble":return Vector4(740,-380,3,.55)
	var mode:String=str(profile.mode)
	if mode in ["spiral","roll","wave"]:return Vector4(340,130,4,.42)
	if mode in ["cloud","web","silk"]:return Vector4(410,-90,5,.24)
	if mode in ["leap","slash","whip","vine"]:return Vector4(780,-430,1,.60)
	if str(profile.socket)=="ground":return Vector4(130,-50,3,.58)
	if int(profile.range)>1:return Vector4(560,-240,2,.55)
	return Vector4(330,-130,1,.48)

func combat_audio_gesture_sample(gesture:Vector4,t:float,p:float,pitch:float,noise:float,body:float)->float:
	var rhythm:float=.22+.78*pow(absf(sin(p*PI*gesture.z)),2.0)
	var transient:float=lerpf(sin(p*PI),pow(1.0-p,2.0),gesture.w)
	var tone:float=sin(TAU*pitch*(gesture.x*t+.5*gesture.y*t*p))
	return (tone*.42+noise*.30*gesture.w+body*.23)*rhythm*transient

# V19.8: short, shared environmental samples. These are not damage sounds.
const ENV_AUDIO_SURFACE={"fire":"ember","water":"splash","ice":"crystal","ground":"gravel","rock":"gravel","poison":"drip","electric":"static","grass":"leaves","dragon":"ember","steel":"metal","flying":"wind"}
# Canonical profiles are stable; each burst owns its playback cursor, not the cues.
var combat_environment_audio_cache:Dictionary={}
func combat_cached_environment_audio_plan(id:String)->Array:
	if not combat_environment_audio_cache.has(id):
		var cues:Array=combat_environment_audio_plan(id,combat_profile(id))
		for cue in cues:cue.make_read_only()
		cues.make_read_only()
		combat_environment_audio_cache[id]=cues
	return combat_environment_audio_cache[id]

func combat_environment_audio_plan(id:String,profile:Dictionary)->Array:
	var peak:float=clampf(float(profile.impact),.12,.88)
	var cues:Array=[]
	match tile_cast_kind(id):
		"burrow":cues.append({"phase":"env_dig","fraction":peak*.22,"anchor":"travel"});cues.append({"phase":"env_gravel","fraction":peak,"anchor":"terrain"})
		"dive":cues.append({"phase":"env_dive","fraction":peak*.24,"anchor":"travel"});cues.append({"phase":"env_splash","fraction":peak,"anchor":"terrain"})
		"air":cues.append({"phase":"env_wind","fraction":peak*.32,"anchor":"travel"});cues.append({"phase":"env_land","fraction":peak,"anchor":"terrain"})
		"vanish":cues.append({"phase":"env_vanish","fraction":peak*.20,"anchor":"travel"});cues.append({"phase":"env_vanish","fraction":peak,"anchor":"terrain"})
		"ground":cues.append({"phase":"env_gravel","fraction":peak*.40,"anchor":"travel"})
	if cues.size()<2:
		var element:String=str(profile.element)
		if ENV_AUDIO_SURFACE.has(element):
			cues.append({"phase":"env_"+str(ENV_AUDIO_SURFACE[element]),"fraction":lerpf(peak,1.0,.24),"anchor":"surface"})
	return cues

func combat_environment_surface_allowed(results:Dictionary,cell:Vector2i,damage:int,element:String)->bool:
	if results.has(cell):return int(results[cell].get("damage",0))>0
	if results.is_empty() and damage>0:return true
	return element in SURFACE_TERRAIN_ELEMENTS

func combat_environment_audio_sample(kind:String,t:float,p:float,noise:float,body:float,slow:float)->float:
	var high:float=noise-body
	match kind:
		"ember":return high*.36*pow(absf(sin(t*TAU*37.0)),8.0)+body*.42
		"splash":return high*.44*pow(1.0-p,1.5)+sin(TAU*(530.0*t-240.0*t*p)+sin(TAU*31.0*t)*1.8)*.23
		"crystal":return (sin(TAU*1970.0*t)*.25+sin(TAU*3127.0*t)*.19)*pow(1.0-p,1.3)+high*.28*pow(absf(sin(p*PI*4.0)),5.0)
		"gravel","dig":return body*.48+high*.32*pow(absf(sin(p*PI*(5.0 if kind=="dig" else 3.0))),4.0)+slow*.36
		"dive":return body*.52+sin(TAU*(340.0*t-150.0*t*p)+sin(TAU*23.0*t)*2.4)*.27
		"drip":return sin(TAU*(540.0*t-310.0*t*p)+sin(p*TAU*3.0)*2.1)*.35+body*.29
		"static":return high*.52*pow(absf(sin(t*TAU*63.0)),4.0)+sin(TAU*1320.0*t)*.14
		"leaves":return high*.45*absf(sin(p*PI*4.0))+body*.24
		"metal":return sin(TAU*1171.0*t)*.26+sin(TAU*2249.0*t)*.17+high*.19*pow(1.0-p,2.0)
		"wind":return body*.66*sin(p*PI)+high*.13
		"land":return slow*.50+body*.32*pow(1.0-p,2.0)
		"vanish":return sin(TAU*(480.0*t+380.0*t*p)+sin(TAU*13.0*t)*1.8)*.28+body*.23
	return 0.0

# V20.0: master once on cache miss, never in the per-frame mixer.
const FX_AUDIO_CACHE_CAP:int=192
const FX_AUDIO_PEAK_LIMIT:float=.78
const FX_AUDIO_STEP_LIMIT:float=.74
const FX_AUDIO_MIX_BUDGET:float=.70
func combat_audio_master_pcm(bytes:PackedByteArray)->float:
	var count:int=bytes.size()/2
	if count<2:return 0.0
	var peak:float=0.0
	var previous:float=0.0
	var filtered:float=0.0
	for i in range(count):
		var input:float=float(bytes.decode_s16(i*2))/32767.0
		# Approximately 18 Hz DC blocker at 22.05 kHz.
		filtered=input-previous+.995*filtered
		previous=input
		var fade:float=minf(1.0,minf(float(i),float(count-1-i))/64.0)
		var value:float=clampf(filtered*fade,-.95,.95)
		bytes.encode_s16(i*2,roundi(value*32767.0))
		peak=maxf(peak,absf(value))
	var gain:float=minf(1.25,FX_AUDIO_PEAK_LIMIT/maxf(.0001,peak))
	var final_peak:float=0.0
	var previous_pcm:int=0
	var step_limit:int=int(FX_AUDIO_STEP_LIMIT*32767.0)
	for i in range(count):
		var pcm:int=roundi(clampf(float(bytes.decode_s16(i*2))*gain,-FX_AUDIO_PEAK_LIMIT*32767.0,FX_AUDIO_PEAK_LIMIT*32767.0))
		# Restrict only extreme adjacent-sample excursions. Ordinary transients
		# and the original decay remain untouched; the terminal fade is silent.
		pcm=clampi(pcm,previous_pcm-step_limit,previous_pcm+step_limit)
		if i==count-1:pcm=0
		bytes.encode_s16(i*2,pcm)
		previous_pcm=pcm
		final_peak=maxf(final_peak,float(absi(pcm))/32767.0)
	return final_peak

# V20.8: pre-rendered original PCM is included by the Android build.
# Read only a single requested sample; the full pack never enters RAM.
func combat_audio_pack_init()->void:
	if fx_audio_pack_checked:return
	fx_audio_pack_checked=true
	var index_file:=FileAccess.open("res://generated_combat_audio/index.json",FileAccess.READ)
	if index_file==null:return
	var index=JSON.parse_string(index_file.get_as_text())
	if not index is Dictionary or int(index.get("version",0))!=1:return
	var entries=index.get("entries",{})
	if not entries is Dictionary:return
	var pack:=FileAccess.open("res://generated_combat_audio/audio.pcm",FileAccess.READ)
	if pack==null or pack.get_length()!=int(index.get("bytes",-1)):return
	fx_audio_pack_index=entries
	fx_audio_pack=pack

func combat_audio_pack_load(key:String)->AudioStreamWAV:
	combat_audio_pack_init()
	if fx_audio_pack==null or not fx_audio_pack_index.has(key):return null
	var row:Array=fx_audio_pack_index[key]
	if row.size()!=3:return null
	var offset:int=int(row[0])
	var length:int=int(row[1])
	var peak:float=float(row[2])
	if offset<0 or length<=0 or length%2!=0 or length>44100 or offset+length>fx_audio_pack.get_length() or peak<0.0 or peak>FX_AUDIO_PEAK_LIMIT+.0001:return null
	fx_audio_pack.seek(offset)
	var bytes:=fx_audio_pack.get_buffer(length)
	if bytes.size()!=length:return null
	var audio:=AudioStreamWAV.new()
	audio.format=AudioStreamWAV.FORMAT_16_BITS
	audio.mix_rate=22050
	audio.stereo=false
	audio.data=bytes
	audio.set_meta("combat_pcm_peak",peak)
	if fx_audio_cache.size()>=FX_AUDIO_CACHE_CAP:evict_oldest_fx_cache_entry(fx_audio_cache)
	fx_audio_cache[key]=audio
	fx_audio_pack_hits+=1
	return audio

func combat_audio_cached(key:String)->AudioStreamWAV:
	if not fx_audio_cache.has(key):return combat_audio_pack_load(key)
	var audio:AudioStreamWAV=fx_audio_cache[key]
	# True LRU: frequently repeated combat effects survive catalog churn.
	fx_audio_cache.erase(key)
	fx_audio_cache[key]=audio
	return audio

func combat_audio_store(key:String,bytes:PackedByteArray,rate:int)->AudioStreamWAV:
	var peak:float=combat_audio_master_pcm(bytes)
	var audio:=AudioStreamWAV.new()
	audio.format=AudioStreamWAV.FORMAT_16_BITS
	audio.mix_rate=rate
	audio.stereo=false
	audio.data=bytes
	audio.set_meta("combat_pcm_peak",peak)
	if fx_audio_cache.size()>=FX_AUDIO_CACHE_CAP:evict_oldest_fx_cache_entry(fx_audio_cache)
	fx_audio_cache[key]=audio
	return audio

# Conservative sum of source peaks, with headroom reserved for critical hits.
# No compressor pumping, extra buses or changes to music/UI audio.
func combat_audio_priority_ceiling(priority:int)->float:
	match priority:
		0:return .34
		1:return .46
		2:return .58
	return FX_AUDIO_MIX_BUDGET

# Reject inaudible events before allocating or synthesizing their PCM.
func combat_audio_can_admit(occupied:float,priority:int)->bool:
	return occupied<combat_audio_priority_ceiling(priority)-.0001

func combat_audio_admission_db(peak:float,requested_db:float,occupied:float,priority:int)->float:
	var available:float=maxf(0.0,combat_audio_priority_ceiling(priority)-maxf(0.0,occupied))
	if available<=.0001:return -80.0
	return minf(requested_db,linear_to_db(available/maxf(.0001,peak)))

func combat_audio_spatial_profile(priority:int)->Vector2:
	# X = unit distance, Y = maximum distance. Contact remains readable
	# from the tactical camera; small atmospheric details stay local.
	match priority:
		0:return Vector2(2.6,14.0)
		1:return Vector2(3.5,20.0)
		_:return Vector2(4.5,24.0)

func combat_environment_sound(phase:String,variant:int)->AudioStreamWAV:
	var key:String=phase+":"+str(variant)
	var cached:=combat_audio_cached(key)
	if cached!=null:return cached
	var kind:String=phase.trim_prefix("env_")
	var rng:=RandomNumberGenerator.new()
	rng.seed=posmod(hash(key),2147483647)
	var rate:int=22050
	var count:int=int(rate*(.22 if kind in ["dig","wind","vanish","ember"] else .16))
	var bytes:=PackedByteArray()
	bytes.resize(count*2)
	var body:float=0.0
	var slow:float=0.0
	for i in range(count):
		var t:float=float(i)/rate
		var p:float=float(i)/maxi(1,count-1)
		var noise:float=rng.randf_range(-1.0,1.0)
		body=lerpf(body,noise,.18)
		slow=lerpf(slow,noise,.045)
		var value:float=combat_environment_audio_sample(kind,t,p,noise,body,slow)*combat_audio_envelope(p,"status")*.72
		bytes.encode_s16(i*2,roundi(clampf(value,-.95,.95)*32767.0))
	return combat_audio_store(key,bytes,rate)

func dispatch_environment_audio(burst:Dictionary)->void:
	var cues:Array=burst.get("environment_audio",[])
	var cursor:int=int(burst.get("environment_audio_cursor",0))
	if cursor>=cues.size() and burst.has("environment_audio_cursor"):return
	var profile:Dictionary=burst.profile
	var duration:float=float(burst.duration)
	var points:Array=burst.points
	var path_metrics:PackedFloat64Array=burst.get("path_metrics",PackedFloat64Array())
	while cursor<cues.size():
		var cue:Dictionary=cues[cursor]
		var fraction:float=float(cue.fraction)
		var age:float=float(burst.age)-fraction*duration
		if age<0.0:break
		cursor+=1
		if age>=.10:continue
		var at:Vector3=points[-1]
		var anchor_kind:String=str(cue.anchor)
		if anchor_kind=="travel":
			at=combat_path_sample(points,combat_travel_progress(fraction,float(profile.impact)),path_metrics)
		elif anchor_kind=="surface":
			var record:Dictionary=Rules.MOVE_LIBRARY.get(str(burst.id),Rules.DEV_NATIVE_MOVES.get(str(burst.id),{}))
			if str(record.get("category",""))=="status":continue
			var cell:=Vector2i(roundi(at.x/1.4),roundi(at.z/1.4))
			if not combat_environment_surface_allowed(burst.get("results",{}),cell,int(burst.get("damage",0)),str(profile.element)):continue
		# Terrain anchors are the actual landing/exit tile, even when an actor evades.
		if anchor_kind!="travel":at.y=.08
		play_combat_sound(str(burst.id),str(cue.phase),at,false,age)
	burst["environment_audio_cursor"]=cursor

# V19.9: use actual outcome tags, never an unconfirmed status chance.
func combat_status_audio_kind(move:Dictionary,row:Dictionary)->String:
	if int(row.get("heal",0))>0:
		return "drain" if move.has("drain_fraction") else "heal"
	var tags:String=str(row.get("status","")).to_lower()
	var changed:bool=bool(row.get("status_changed",false)) or int(row.get("effects",0))>0 or (int(row.get("damage",0))>0 and not tags.is_empty())
	if not changed:return ""
	# New attempt records contain only newly applied tags.
	for tag in tags.split(" · ",false):
		match tag:
			"sleep","drowsy":return "sleep"
			"confused","confusion":return "confusion"
			"poison","toxic","poisoned":return "poison"
			"burn","burned":return "burn"
			"paralysis","paralyzed":return "paralysis"
			"freeze","frozen":return "freeze"
			"stuck","wrapped","leech","paused","encore","sealed":return "bind"
			"nightmare","perish","curse","heal block","taunt","embargo":return "curse"
			"infatuated":return "heart"
	if int(row.get("effects",0))>0 or bool(row.get("status_changed",false)):
		var kind:String=status_finish_kind(move)
		if not kind.is_empty():
			if str(move.get("inflict_status","")) in ["freeze","frozen"]:return "freeze"
			return kind
	return ""

# Each short motif has its own contour and articulation. Phase is normalized
# so changing the playback frame rate never changes the underlying PCM.
func combat_status_audio_sample(kind:String,t:float,p:float,noise:float,variant:int)->float:
	var pitch:float=1.0+float(variant-1)*.025
	var bright:float=sin(TAU*880.0*t*pitch)
	match kind:
		"heal":return sin(TAU*pitch*(440.0*t+280.0*t*p))*.42+bright*.14
		"drain":return sin(TAU*pitch*(630.0*t-210.0*t*p)+sin(TAU*9.0*t)*1.4)*.36+sin(TAU*pitch*330.0*t)*.18
		"cleanse":return sin(TAU*pitch*(760.0*t+460.0*t*p))*.30+bright*.18+noise*.07*(1.0-p)
		"shield":return sin(TAU*pitch*390.0*t)*.30+sin(TAU*pitch*1170.0*t)*.22*pow(1.0-p,2.0)
		"boost":return sin(TAU*pitch*(330.0*t+540.0*t*p))*.42*(.45+.55*absf(sin(p*PI*3.0)))
		"weaken":return sin(TAU*pitch*(700.0*t-490.0*t*p))*.40*(.45+.55*absf(sin(p*PI*2.0)))
		"exchange":return sin(TAU*pitch*(480.0*t+260.0*t*p)+sin(p*TAU*2.0)*1.7)*.35+sin(TAU*pitch*(720.0*t-240.0*t*p))*.19
		"transform":return sin(TAU*pitch*(240.0*t+720.0*t*p)+sin(p*TAU*3.0)*2.0)*.34+sin(TAU*pitch*960.0*t)*.16
		"sleep":return sin(TAU*pitch*440.0*t)*.30+sin(TAU*pitch*660.0*t)*.14
		"confusion":return sin(TAU*pitch*540.0*t+sin(TAU*13.0*t)*3.2)*.40
		"poison":return sin(TAU*pitch*(180.0*t+130.0*t*p)+sin(TAU*24.0*t)*2.8)*.36+noise*.09
		"burn":return sin(TAU*pitch*125.0*t)*.22+noise*.34*pow(absf(sin(p*PI*5.0)),3.0)
		"paralysis":return (noise*.30+sin(TAU*pitch*1370.0*t)*.30)*pow(absf(sin(p*PI*7.0)),4.0)
		"freeze":return sin(TAU*pitch*1900.0*t)*.28+sin(TAU*pitch*2810.0*t)*.19+noise*.12*pow(1.0-p,3.0)
		"curse":return sin(TAU*pitch*(145.0*t-55.0*t*p)+sin(TAU*8.0*t)*2.0)*.40+sin(TAU*pitch*219.0*t)*.16
		"heart":return sin(TAU*pitch*523.25*t)*.29+sin(TAU*pitch*783.99*t)*.18
		"bind":return (noise*.24+sin(TAU*pitch*230.0*t)*.28)*(.3+.7*pow(absf(sin(p*PI*3.0)),4.0))
		"trap":return (noise*.22+sin(TAU*pitch*510.0*t)*.25)*(.2+.8*pow(absf(sin(p*PI*2.0)),6.0))
		"weather":return noise*.23*sin(p*PI)+sin(TAU*pitch*(330.0*t+180.0*t*p))*.22
		"blocked":return sin(TAU*pitch*(260.0*t-150.0*t*p))*.24*pow(1.0-p,2.0)
		_:return sin(TAU*pitch*(460.0*t+160.0*t*p))*.32+bright*.12

func combat_status_sound(phase:String,variant:int)->AudioStreamWAV:
	var key:String=phase+":"+str(variant)
	var cached:=combat_audio_cached(key)
	if cached!=null:return cached
	var kind:String=phase.trim_prefix("status_")
	var rng:=RandomNumberGenerator.new()
	rng.seed=posmod(hash(key),2147483647)
	var rate:int=22050
	var count:int=int(rate*(.11 if kind=="blocked" else .24))
	var bytes:=PackedByteArray()
	bytes.resize(count*2)
	for i in range(count):
		var p:float=float(i)/maxi(1,count-1)
		var value:float=combat_status_audio_sample(kind,float(i)/rate,p,rng.randf_range(-1.0,1.0),variant)*combat_audio_envelope(p,"status")*.72
		bytes.encode_s16(i*2,roundi(clampf(value,-.95,.95)*32767.0))
	return combat_audio_store(key,bytes,rate)

func combat_sound(id:String,phase:String,variant:int)->AudioStreamWAV:
	var key:=id+":"+phase+":"+str(variant)
	var cached:=combat_audio_cached(key)
	if cached!=null:return cached
	var profile:=combat_profile(id)
	var element:String=profile.element
	var role:String=profile.role
	var seed_value:int=posmod(hash(key),2147483647)
	var rng:=RandomNumberGenerator.new();rng.seed=seed_value
	var form:=combat_audio_form(id,profile)
	var duration:=combat_audio_duration(profile,form,phase)
	var rate:int=22050
	var samples:int=int(duration*rate)
	var data:=PackedByteArray();data.resize(samples*2)
	var last_noise:float=0.0
	var slow_noise:float=0.0
	var previous_noise:float=0.0
	var electric_gate:float=.30+.70*float(seed_value%13%5<3)
	# Keep the same tonal identity across variants and playback phases.
	var identity_seed:int=posmod(hash(id),2147483647)
	var pitch:float=1.0+float(identity_seed%23-11)*.008+float(variant-1)*.025
	var gesture:Vector4=combat_audio_gesture(id,profile)
	var strike:bool=phase=="impact"
	var missed:bool=phase=="miss"
	var status_phase:bool=phase=="status"
	var attack:float=.045 if strike or missed else .12
	var release:float=.14 if strike else .22
	var inv_rate:float=1.0/float(rate)
	var inv_samples:float=1.0/float(samples)
	var inv_end:float=1.0/float(maxi(1,samples-1))
	for i in range(samples):
		var t:float=float(i)*inv_rate;var p:float=float(i)*inv_samples
		var noise:float=rng.randf_range(-1.0,1.0)
		var rounded_noise:float=.70*noise+.30*previous_noise
		previous_noise=noise
		last_noise=lerpf(last_noise,noise,.18)
		slow_noise=lerpf(slow_noise,noise,.045)
		var ep:float=float(i)*inv_end
		var envelope:float=smoothstep(0.0,attack,ep)*(1.0-smoothstep(1.0-release,1.0,ep))*pow(maxf(0.0,1.0-ep),.85)
		var wave:float=0.0
		# V19.6: separate elemental materials rather than recoloring one oscillator.
		match element:
			"electric":
				var gate:float=.30+.70*float(posmod(int(t*170.0)+seed_value%13,5)<3)
				electric_gate=lerpf(electric_gate,gate,.28)
				wave=(rounded_noise*.47+sin(TAU*pitch*(210.0*t+3500.0*t*t))*.31+sin(TAU*1220.0*t*pitch)*.17)*electric_gate
			"water":
				wave=sin(TAU*pitch*(310.0*t+720.0*t*t)+sin(TAU*37.0*t)*2.5)*.48+last_noise*.23
				wave*=.45+.55*absf(sin(TAU*13.0*t))
			"fire":
				wave=(last_noise*.85+noise*.19+sin(TAU*78.0*t*pitch)*.14)*(.65+.35*absf(sin(t*TAU*19.0)))
			"grass":
				wave=(noise-last_noise)*.43*(.35+.65*sin(p*PI))+sin(TAU*pitch*(680.0*t-620.0*t*t))*.22
			"bug":
				var trill:float=pow(absf(sin(TAU*42.0*t)),3.0)
				wave=(sin(TAU*1850.0*t*pitch)*.30+(noise-last_noise)*.37)*trill+last_noise*.13
			"ground":
				wave=sin(TAU*pitch*(94.0*t-85.0*t*t))*.62+slow_noise*.78+last_noise*.25
			"rock":
				var grit:float=.3+.7*pow(absf(sin(p*TAU*3.0)),4.0)
				wave=sin(TAU*pitch*(160.0*t-85.0*t*p))*.35+(noise-last_noise)*.46*grit+last_noise*.42
			"steel":
				wave=sin(TAU*610.0*t*pitch)*.32+sin(TAU*1437.0*t*pitch)*.24+sin(TAU*2371.0*t*pitch)*.13+(noise-last_noise)*.14*pow(1.0-p,3.0)
			"ice":
				wave=sin(TAU*1480.0*t*pitch)*.26+sin(TAU*2230.0*t)*.17+noise*.27*pow(1.0-p,2.0)
			"psychic":
				wave=sin(TAU*pitch*(420.0*t+120.0*t*t)+sin(TAU*21.0*t)*1.8)*.43+sin(TAU*880.0*t*pitch)*.18+last_noise*.10
			"fairy":
				wave=sin(TAU*660.0*t*pitch)*.28+sin(TAU*990.0*t*pitch)*.18+sin(TAU*1320.0*t*pitch)*.13+sin(TAU*1980.0*t*pitch)*.09
			"ghost":
				wave=sin(TAU*pitch*(390.0*t-180.0*t*p)+sin(TAU*7.0*t)*2.3)*.39+sin(TAU*211.0*t*pitch)*.17+last_noise*.21
			"dragon":
				wave=sin(TAU*pitch*(92.0*t-32.0*t*p)+sin(TAU*47.0*t)*1.7)*.48+sin(TAU*184.0*t*pitch)*.19+slow_noise*.46
			"dark":
				wave=sin(TAU*pitch*(115.0*t-52.0*t*p)+sin(TAU*23.0*t)*1.3)*.43+slow_noise*.47+(noise-last_noise)*.12
			"poison":
				wave=sin(TAU*pitch*(170.0*t+300.0*t*t)+sin(TAU*33.0*t)*3.0)*.42+last_noise*.33
			"flying":
				wave=(noise-last_noise)*.34*sin(p*PI)+last_noise*.52+sin(TAU*pitch*(940.0*t-620.0*t*p))*.18
			"fighting":
				wave=sin(TAU*pitch*(145.0*t-70.0*t*p))*.51*pow(1.0-p,1.4)+(noise-last_noise)*.28
			_:
				wave=last_noise*.53+sin(TAU*pitch*(185.0*t-155.0*t*t))*.43
		# A second, authored acoustic layer separates attacks within each nature.
		var accent:float=0.0
		var sweep:float=sin(TAU*pitch*(780.0*t-560.0*t*p))
		match form:
			"punch","thump":
				accent=sin(TAU*pitch*(125.0*t-65.0*t*p))*pow(1.0-p,2.0)*.64+(noise-last_noise)*.32*pow(1.0-p,4.0)
			"kick":
				accent=sin(TAU*pitch*(88.0*t-38.0*t*p))*pow(1.0-p,1.7)*.66+last_noise*.34*sin(p*PI)+(noise-last_noise)*.18
			"fang":
				var snap:float=exp(-pow((p-.16)/.09,2.0))
				accent=(rounded_noise-last_noise)*snap*.66+sin(TAU*220.0*t*pitch)*snap*.32
			"crunch":
				var snap:float=exp(-pow((p-.12)/.09,2.0))+.72*exp(-pow((p-.40)/.14,2.0))
				accent=(noise-last_noise)*snap*.60+sin(TAU*105.0*t*pitch)*snap*.48+last_noise*.28
			"pincer":
				var snap:float=exp(-pow((p-.15)/.065,2.0))+.65*exp(-pow((p-.28)/.065,2.0))
				accent=(noise-last_noise)*snap*.55+sin(TAU*1550.0*t*pitch)*snap*.28
			"claw":
				accent=(rounded_noise-last_noise)*(.32+.26*absf(sin(p*TAU*2.0)))+sweep*.25
			"slice":
				accent=(noise-last_noise)*.49*sin(p*PI)+sin(TAU*pitch*(1450.0*t-880.0*t*p))*.25
			"wind":accent=last_noise*.56*sin(p*PI)+sweep*.17
			"detonation","shockwave","rumble","stone":
				accent=slow_noise*.85+sin(TAU*pitch*(72.0*t-32.0*t*p))*.55*pow(1.0-p,1.8)
			"implosion","void":accent=sin(TAU*pitch*(180.0*t+640.0*t*p))*.42+slow_noise*.35
			"bubble","liquid":accent=sin(TAU*pitch*(580.0*t-380.0*t*p)+sin(p*TAU*3.0)*1.6)*.44
			"glass","metal":accent=sin(TAU*1760.0*t*pitch)*.26+sin(TAU*2630.0*t*pitch)*.16
			"chime","resonance","beam":accent=sin(TAU*pitch*(520.0*t+180.0*t*p))*.32+sin(TAU*1040.0*t*pitch)*.18
			"spectral":accent=sin(TAU*pitch*(310.0*t-140.0*t*p)+sin(t*TAU*15.0)*2.2)*.38
			"flame","roar":accent=slow_noise*.65+last_noise*.45
			"arc":accent=(noise-last_noise)*.38*(.55+.45*sin(p*TAU*7.0))
			"rustle","chitin":accent=(noise-last_noise)*.38*absf(sin(p*TAU*4.0))
			"viscous":accent=sin(TAU*pitch*(180.0*t-70.0*t*p)+sin(p*TAU*4.0)*2.6)*.34
		wave=wave*.60+accent*(.85 if strike else .62)
		if not missed:
			# Gesture controls the whole accent envelope, not merely an added tone.
			var articulation:float=.68+.32*pow(absf(sin(p*PI*gesture.z)),2.0)
			wave=wave*.77*articulation+combat_audio_gesture_sample(gesture,t,p,pitch,rounded_noise-last_noise,slow_noise)*(.69 if strike else .59)
		if strike:wave+=sin(TAU*95.0*t*pitch)*.17*pow(1.0-p,2.0)
		elif missed:wave=(noise-last_noise)*.34+sweep*.12
		elif status_phase:wave=sin(TAU*520.0*t*pitch)*.20+sin(TAU*780.0*t*pitch)*.14+wave*.55
		# Smooth saturation, with exact silent endpoints to avoid PCM clicks.
		var signal_value:float=wave*envelope*.85
		var pcm:int=roundi(clampf(signal_value/(1.0+absf(signal_value)*.35),-.95,.95)*32767.0)
		data.encode_s16(i*2,pcm)
	return combat_audio_store(key,data,rate)
# Playback-only mix: preserve the authored PCM and cache. Critical contacts
# have priority over launches and misses when all twelve voices are occupied.
func combat_audio_mix(power:int,phase:String,critical:bool=false)->Vector3:
	if phase.begins_with("env_"):return Vector3(-23.0,1.0,0.0)
	if phase=="status_blocked":return Vector3(-22.0,1.0,0.0)
	if phase.begins_with("status_") or phase=="status":return Vector3(-16.0,1.0,1.0)
	if phase=="miss":return Vector3(-19.0,1.0,0.0)
	var weight:float=cinematic_power_sample(power,false).x
	var gain:float=clampf(20.0*log(maxf(.01,weight))/log(10.0),-2.0,3.0)
	match phase:
		"launch":return Vector3(-15.0+gain*.45,clampf(1.0-(weight-1.0)*.09,.94,1.04),1.0)
		_:return Vector3(minf(-8.0,-12.0+gain+(1.5 if critical else 0.0)),clampf(1.0-(weight-1.0)*.15,.92,1.04),3.0 if critical else 2.0)

# Priority is independent of power: sorting a frame does not need envelope math.
func combat_audio_phase_priority(phase:String,critical:bool=false)->int:
	if phase.begins_with("env_") or phase=="status_blocked" or phase=="miss":return 0
	if phase.begins_with("status_") or phase=="status" or phase=="launch":return 1
	return 3 if critical else 2

func combat_audio_voice_slot(priorities:Array[int],cursor:int,priority:int,frame_mask:int=0)->int:
	if priorities.is_empty():return -1
	var weakest:int=priority
	var slot:int=-1
	for i in range(priorities.size()):
		var candidate:int=posmod(cursor+i,priorities.size())
		var active:int=priorities[candidate]
		if active<0:return candidate
		if active<weakest:
			weakest=active;slot=candidate
	# Allow a damaging contact to replace an equally important OLD voice.
	# A voice admitted in this flush has not had a chance to reach the mixer.
	if slot<0 and priority>=2:
		for i in range(priorities.size()):
			var candidate:int=posmod(cursor+i,priorities.size())
			if priorities[candidate]==priority and (frame_mask & (1<<candidate))==0:return candidate
	return slot

# All cues due in the same visual update share a chronological admission pass.
# Age is elapsed time since the authored cue, so greater age means earlier.
func combat_audio_event_before(a:Dictionary,b:Dictionary)->bool:
	if float(a.age)!=float(b.age):return float(a.age)>float(b.age)
	if int(a.priority)!=int(b.priority):return int(a.priority)>int(b.priority)
	if str(a.id)!=str(b.id):return str(a.id)<str(b.id)
	if str(a.phase)!=str(b.phase):return str(a.phase)<str(b.phase)
	var p:Vector3=a.at
	var q:Vector3=b.at
	if p.x!=q.x:return p.x<q.x
	if p.y!=q.y:return p.y<q.y
	return p.z<q.z

func begin_combat_audio_frame()->void:
	fx_frame_audio.clear()
	fx_collect_audio=true

func flush_combat_audio_frame()->void:
	fx_collect_audio=false
	fx_flushing_audio=true
	fx_frame_voice_mask=0
	if fx_frame_audio.size()>1:fx_frame_audio.sort_custom(combat_audio_event_before)
	for cue in fx_frame_audio:
		play_combat_sound(str(cue.id),str(cue.phase),cue.at,bool(cue.critical),float(cue.age))
	fx_frame_audio.clear()
	fx_flushing_audio=false
	fx_frame_voice_mask=0

# Keep the queue unbounded as before; only retained reusable storage is capped.
func queue_combat_audio_cue(id:String,phase:String,at:Vector3,critical:bool,age:float)->void:
	var index:int=fx_frame_audio.size()
	var cue:Dictionary
	if index<FX_AUDIO_CUE_POOL_CAP:
		if index==fx_audio_cue_pool.size():fx_audio_cue_pool.append({})
		cue=fx_audio_cue_pool[index]
	else:cue={}
	cue["id"]=id;cue["phase"]=phase;cue["at"]=at
	cue["critical"]=critical;cue["age"]=maxf(0.0,age)
	cue["priority"]=combat_audio_phase_priority(phase,critical)
	fx_frame_audio.append(cue)

func play_combat_sound(id:String,phase:String,at:Vector3,critical:bool=false,age:float=0.0)->void:
	if fx_collect_audio:
		queue_combat_audio_cue(id,phase,at,critical,age)
		return
	if fx_audio.is_empty():return
	var priority:int=combat_audio_phase_priority(phase,critical)
	# Refresh live voice state for every admission, but reuse the typed storage.
	if fx_voice_priorities.size()!=fx_audio.size():fx_voice_priorities.resize(fx_audio.size())
	for i in range(fx_audio.size()):
		var voice:AudioStreamPlayer3D=fx_audio[i]
		fx_voice_priorities[i]=int(voice.get_meta("combat_audio_priority",0)) if voice.playing else -1
	var slot:int=combat_audio_voice_slot(fx_voice_priorities,fx_audio_cursor,priority,fx_frame_voice_mask if fx_flushing_audio else 0)
	if slot<0:return
	var occupied:float=0.0
	for i in range(fx_audio.size()):
		if i==slot or not fx_audio[i].playing:continue
		var other:AudioStreamPlayer3D=fx_audio[i]
		var other_peak:float=float(other.get_meta("combat_pcm_peak",FX_AUDIO_PEAK_LIMIT))
		occupied+=other_peak*db_to_linear(other.volume_db)
	if not combat_audio_can_admit(occupied,priority):return
	# Fixed-gain motifs never need a move record or power envelope.
	var power:int=0
	if phase=="launch" or priority>=2:
		var record:Dictionary=Rules.MOVE_LIBRARY[id] if Rules.MOVE_LIBRARY.has(id) else Rules.DEV_NATIVE_MOVES.get(id,{})
		power=int(record.get("power",0))
	var mix:=combat_audio_mix(power,phase,critical)
	# Shared motifs use a shared rotation; avoid one counter per move and motif.
	var key:String=phase if phase.begins_with("env_") or phase.begins_with("status_") else id+":"+phase
	var variant:int=posmod(int(fx_audio_counter.get(key,-1))+1,3)
	var stream:AudioStreamWAV
	if phase.begins_with("env_"):stream=combat_environment_sound(phase,variant)
	elif phase.begins_with("status_"):stream=combat_status_sound(phase,variant)
	else:stream=combat_sound(id,phase,variant)
	# A late frame skips elapsed audio instead of replaying an old transient.
	var offset:float=maxf(0.0,age)*mix.y
	if offset>=stream.get_length()-.008:return
	var peak:float=float(stream.get_meta("combat_pcm_peak",FX_AUDIO_PEAK_LIMIT))
	var admitted_db:float=combat_audio_admission_db(peak,mix.x,occupied,int(mix.z))
	if admitted_db< -40.0:return
	fx_audio_counter[key]=variant
	var player_audio:=fx_audio[slot];fx_audio_cursor=posmod(slot+1,fx_audio.size())
	player_audio.stop()
	player_audio.position=at
	player_audio.stream=stream
	player_audio.volume_db=admitted_db
	player_audio.set_meta("combat_pcm_peak",peak)
	var spatial:Vector2=combat_audio_spatial_profile(int(mix.z))
	player_audio.unit_size=spatial.x
	player_audio.max_distance=spatial.y
	player_audio.pitch_scale=mix.y
	player_audio.set_meta("combat_audio_priority",int(mix.z))
	player_audio.play(offset)
	if fx_flushing_audio:fx_frame_voice_mask|=1<<slot

# Tile anchors remain deterministic; sprite scale and hover offset locate the
# launch/impact socket without moving logical combat or collision tiles.
func combat_socket_height(socket:String,scale:float=1.0,rise:float=0.0)->float:
	if socket=="ground":return .13
	return (.66 if socket=="head" else .45)*maxf(.1,scale)+maxf(0.0,rise)

func combat_actor_socket(actor:Node3D,socket:String)->float:
	if not is_instance_valid(actor):return combat_socket_height(socket)
	var scale:float=float(actor.get_meta("enemy_size_multiplier",1.0))
	var sprite:=actor.get_node_or_null("EnemyPixel") as Sprite3D
	# Remove squash/stretch from measured altitude: deformation is not flight.
	var rise:float=sprite.position.y-.54*scale*sprite.scale.y if sprite!=null else 0.0
	if actor==pet_pose or actor.get_meta("companion_disguise",false):rise+=actor.position.y
	return combat_socket_height(socket,scale,maxf(0.0,rise))

func combat_target_actor(cell:Vector2i)->Node3D:
	if run==null:return null
	if cell==run.player:return disguise_actor if is_instance_valid(disguise_actor) else pet_pose
	for enemy in run.enemies:
		if enemy.pos==cell:
			var actor=actor_nodes.get("enemy:"+str(enemy.get("uid",-1)))
			if is_instance_valid(actor) and not actor.is_queued_for_deletion():return actor
	# Defeated actors may still await impact; their logical target is retained.
	var target_position:Vector3=pos(cell)
	for key in actor_nodes:
		if not str(key).begins_with("enemy:"):continue
		var actor=actor_nodes[key]
		if is_instance_valid(actor) and not actor.is_queued_for_deletion() and actor.get_meta("target",Vector3.INF)==target_position:return actor
	return null

func combat_waypoints(source:Vector2i,target:Vector2i,path:Array,source_height:float,target_height:float)->Array:
	var points:Array=[pos(source)+Vector3.UP*source_height]
	var cells:Array=[source]
	for cell in path:
		if cell is Vector2i and cell!=cells[-1]:cells.append(cell)
	if cells[-1]!=target:cells.append(target)
	if cells.size()==1:
		points.append(pos(target)+Vector3.UP*target_height)
	else:
		for i in range(1,cells.size()):
			points.append(pos(cells[i])+Vector3.UP*lerpf(source_height,target_height,float(i)/float(cells.size()-1)))
	return points

# Deferred casts snapshot heights along with tiles, not live actors at replay time.
func snapshot_counter_geometry(event:Dictionary,source_actor:Node3D,target_actor:Node3D)->Dictionary:
	var result:Dictionary=event.duplicate(true)
	var profile:=combat_profile(str(result.fx))
	result["source_height"]=combat_actor_socket(source_actor,str(profile.socket))
	result["target_height"]=combat_actor_socket(target_actor,"center")
	return result

func combat_fx_spawn(event:Dictionary,launch_age:float=0.0)->void:
	if not is_instance_valid(combat_fx_root):return
	var id:String=str(event.get("fx","basic_strike"))
	var style:Array=combat_style(id)
	var profile:=combat_profile(id)
	var source:Vector2i=event.get("from",Vector2i.ZERO)
	var target:Vector2i=event.get("to",source)
	var source_actor:Node3D=null
	if not event.has("source_height"):
		if event.has("uid"):
			var candidate=actor_nodes.get("enemy:"+str(event.uid))
			if is_instance_valid(candidate):source_actor=candidate
		else:
			source_actor=disguise_actor if is_instance_valid(disguise_actor) else pet_pose
	var height:float=float(event.source_height) if event.has("source_height") else combat_actor_socket(source_actor,str(profile.socket))
	var target_height:float=float(event.target_height) if event.has("target_height") else combat_actor_socket(combat_target_actor(target),"center")
	if source==target and str(profile.socket)=="ground":target_height=height
	var waypoints:Array=combat_waypoints(source,target,event.get("path",[target]),height,target_height)
	var tiles:Array=[]
	for cell in event.get("tiles",[target]):tiles.append(pos(cell)+Vector3(0,.12,0))
	if tiles.is_empty():tiles.append(pos(target)+Vector3(0,.12,0))
	if combat_bursts.size()>=COMBAT_BURST_CAP:
		retire_combat_burst(combat_bursts.pop_front())
	var cast_frames:Array=combat_cast_frames(id)
	combat_bursts.append({"frames":cast_frames,"id":id,"mode":style[0],"profile":profile,"target_player":event.get("target_player",false),"damage":event.get("damage",0),"impacted":false,"age":0.0,"duration":float(style[3]),"points":waypoints,"path_metrics":combat_path_metrics(waypoints),"tiles":tiles,"texture":combat_cast_frame(id,cast_frames,0),"cached_frame":0,"airborne_start":not event.has("uid") and release_charge_phase=="airborne","results":event.get("results",{}).duplicate(true)})
	var burst:Dictionary=combat_bursts[-1]
	burst["lab_preview"]=event.get("lab_preview",false)
	burst["impact_waves"]=cast_impact_waves(burst.results)
	burst["impact_times"]=reaction_times(float(burst.duration),float(profile.impact),burst.impact_waves.size())
	burst["impact_cursor"]=0
	prepare_impact_snapshots(burst)
	burst["environment_audio"]=combat_cached_environment_audio_plan(id)
	burst["environment_audio_cursor"]=0
	if launch_age<.14:play_combat_sound(id,"launch",waypoints[0],false,launch_age)
# Leading projectile reaches its destination on the exact impact fraction.
# Trailing particles are delayed within the remaining lifetime, never beyond it.
func combat_travel_progress(t:float,impact:float,trail:float=0.0)->float:
	var peak:float=clampf(impact,.001,.999)
	var delay:float=clampf(trail,0.0,.9)*(1.0-peak)
	return clampf((t-delay)/peak,0.0,1.0)

# A cast's clamped peak is invariant across all of its particles.
func combat_travel_progress_from_peak(t:float,peak:float,trail:float=0.0)->float:
	var delay:float=clampf(trail,0.0,.9)*(1.0-peak)
	return clampf((t-delay)/peak,0.0,1.0)

# Metrics are immutable per cast: [total distance, segment 1, segment 2, ...].
# Keep double precision and original summation order, including tiny segments.
func combat_path_metrics(points:Array)->PackedFloat64Array:
	var metrics:=PackedFloat64Array()
	metrics.resize(maxi(1,points.size()))
	var total:float=0.0
	for i in range(1,points.size()):
		var a:Vector3=points[i-1]
		var distance:float=a.distance_to(points[i])
		metrics[i]=distance
		total+=distance
	metrics[0]=total
	fx_path_metrics_builds+=1
	return metrics

func combat_path_sample(points:Array,t:float,metrics:PackedFloat64Array=PackedFloat64Array())->Vector3:
	if points.is_empty():return Vector3.ZERO
	if points.size()==1 or t<=0.0:return points[0]
	if t>=1.0:return points[-1]
	if metrics.size()!=points.size():
		fx_path_fallback_samples+=1
		metrics=combat_path_metrics(points)
	else:fx_path_cached_samples+=1
	var length:float=metrics[0]
	if length<.00001:return points[-1]
	var remaining:float=clampf(t,0.0,1.0)*length
	for i in range(1,points.size()):
		var distance:float=metrics[i]
		if distance<.00001:continue
		if remaining<=distance:
			var a:Vector3=points[i-1]
			return a.lerp(points[i],remaining/distance)
		remaining-=distance
	return points[-1]

# World-space anatomy of a lash: one continuous extending/retracting stem, not
# repeated thumbnail sprites. Leaves and tendrils follow the actual curve.
func vine_world_lash(points:Array,t:float,profile:Dictionary,id:String,metrics:PackedFloat64Array=PackedFloat64Array())->void:
	if metrics.size()!=points.size():metrics=combat_path_metrics(points)
	var style:Array=combat_style(id)
	var light:=Color(style[1]);var dark:=Color(style[2]);var outline:=dark.darkened(.55)
	var peak:float=clampf(float(profile.impact),.12,.88)
	var hold:float=peak+(1.0-peak)*.25
	var reach:float=combat_travel_progress(t,peak) if t<hold else clampf((1.0-t)/maxf(.01,1.0-hold),0.0,1.0)
	var last:Vector3=points[0]
	var steps:int=mini(42,maxi(12,points.size()*9))
	for j in range(1,steps+1):
		if fx_arc_segments>1000:return
		var f:float=float(j)/steps
		var q:=combat_path_sample(points,f*reach,metrics)
		var next:=combat_path_sample(points,minf(1.0,f*reach+.025),metrics)
		var lateral:Vector3=(next-last).cross(Vector3.UP).normalized()
		q+=lateral*sin(f*TAU*1.2-t*8.0)*.14*f*reach
		q.y+=sin(f*PI)*.25*reach
		var width:float=lerpf(.095,.026,f)*(1.8 if profile.role=="grass_whip" else 1.0)
		arc_segment(last,q,width,outline)
		arc_segment(last,q,width*.70,dark)
		arc_segment(last+Vector3.UP*.018,q+Vector3.UP*.018,width*.25,light)
		if j%6==0 and profile.element=="grass":
			var leaf:=q+lateral*(.16 if j%12==0 else -.16)+Vector3.UP*.10
			arc_segment(q,leaf,.055,dark);arc_segment(q,leaf,.023,light)
		last=q
# Ground cracks stay flush with the tile surface. Debris sprites are independent.
func quake_world_tiles(tiles:Array,t:float,id:String)->void:
	var style:Array=combat_style(id)
	var light:=Color(style[1]);var dark:=Color(style[2])
	var growth:float=clampf(t*2.0,0.0,1.0)
	var crack_color:Color=dark.darkened(.65)
	for center_value in tiles:
		var center:Vector3=center_value
		center.y=.035
		var crack_phase:float=float(posmod(hash(str(center)),17))*.12
		for i in range(5):
			if fx_arc_segments>1000:return
			var angle:float=float(i)*TAU/5.0+crack_phase
			var direction:=Vector3(cos(angle),0,sin(angle))
			var bend:=center+direction*.32*growth+Vector3(-direction.z,0,direction.x)*.12*growth
			var tip:=center+direction*.61*growth
			arc_segment(center,bend,.047,crack_color)
			arc_segment(bend,tip,.035,crack_color)
			arc_segment(bend+Vector3.UP*.009,tip+Vector3.UP*.009,.011,light)
func reaction_times(duration:float,impact:float,count:int)->Array[float]:
	var times:Array[float]=[]
	var first:float=maxf(0.0,duration*clampf(impact,0.0,1.0))
	var span:float=maxf(0.0,duration-first)
	for i in range(clampi(count,1,12)):
		times.append(first+span*.85*float(i)/maxi(1,clampi(count,1,12)-1))
	return times

func queue_enemy_reaction(actor:Node3D,defeated:bool,delay:float,direction:Vector3=Vector3.ZERO,span:float=0.0,count:int=1,explicit_times:Array[float]=[],impact_weight:float=1.0)->void:
	if not is_instance_valid(actor):return
	# If a new action kills an actor before its earlier hit resolves, retire the
	# older nonterminal callbacks so they cannot overwrite its defeat pose.
	if defeated:
		var retained:int=0
		for reaction in fx_reactions:
			if reaction.actor==actor:continue
			fx_reactions[retained]=reaction;retained+=1
		fx_reactions.resize(retained)
	actor.set_meta("pending_impact",true)
	if defeated:actor.set_meta("pending_defeat",true)
	var times:Array[float]=explicit_times if not explicit_times.is_empty() else reaction_times(delay+span,delay/(delay+span) if delay+span>0.0 else 0.0,count)
	for i in range(times.size()):
		fx_reactions.append({"actor":actor,"delay":times[i],"defeated":defeated and i==times.size()-1,"direction":direction,"weight":clampf(impact_weight,.78,1.48)})

# Stable compaction preserves future queue order. Reverse due entries before
# sorting to preserve the original reverse traversal on identical timestamps.
func collect_due_enemy_reactions(dt:float)->void:
	fx_due_reactions.clear()
	fx_pending_reaction_actors.clear()
	var retained:int=0
	for reaction in fx_reactions:
		reaction.delay-=dt
		if float(reaction.delay)>0.0:
			fx_reactions[retained]=reaction;retained+=1
			var actor=reaction.actor
			if is_instance_valid(actor):fx_pending_reaction_actors[actor.get_instance_id()]=true
		else:fx_due_reactions.append(reaction)
	fx_reactions.resize(retained)
	fx_due_reactions.reverse()

func update_combat_reactions(dt:float)->void:
	# Process chronological order even if a slow frame crosses several impacts.
	if fx_reactions.is_empty():return
	collect_due_enemy_reactions(dt)
	var due:Array[Dictionary]=fx_due_reactions
	due.sort_custom(func(a:Dictionary,b:Dictionary)->bool:
		if float(a.delay)==float(b.delay):return not bool(a.defeated) and bool(b.defeated)
		return float(a.delay)<float(b.delay))
	for reaction in due:
		var actor=reaction.actor
		if not is_instance_valid(actor) or actor.is_queued_for_deletion():continue
		if str(actor.get_meta("enemy_phase",""))=="defeat":continue
		actor.set_meta("pending_impact",fx_pending_reaction_actors.has(actor.get_instance_id()))
		actor.set_meta("enemy_hit_direction",reaction.direction)
		actor.set_meta("enemy_hit_weight",float(reaction.get("weight",1.0)))
		enemy_pose(actor,"defeat" if reaction.defeated else "hurt",.32 if reaction.defeated else .20)
		queue_ultra_reaction(actor.global_position+Vector3.UP*.54,reaction.direction,bool(reaction.defeated),maxf(0.0,-float(reaction.delay)))
		# The actor renderer advances dt later in this frame. Subtract the
		# pre-impact portion now so only the actual post-impact age is applied.
		actor.set_meta("enemy_clock",-clampf(dt+float(reaction.delay),0.0,dt))
		if reaction.defeated:
			actor.set_meta("pending_defeat",false)
			var bar=actor.get_node_or_null("HP")
			var warning=actor.get_node_or_null("Warning")
			if bar!=null:bar.hide()
			if warning!=null:warning.hide()
	fx_due_reactions.clear()
	fx_pending_reaction_actors.clear()
# Both immediate and delayed casts use the same body presentation contract.
func player_cast_sample(id:String,source:Vector2i,target:Vector2i,age:float=0.0)->Dictionary:
	var profile:=combat_profile(id)
	var duration:float=float(profile.duration)
	var direction:Vector3=(pos(target)-pos(source)).normalized()
	if direction.length_squared()<.0001:direction=Vector3(facing.x,0,facing.y).normalized()
	return {"duration":duration,"remaining":maxf(0.0,duration-age),"impact":float(profile.impact),"impact_delay":maxf(0.0,duration*float(profile.impact)-age),"role":str(profile.role),"motion":cast_motion_kind(id,profile),"direction":direction}

func tile_cast_kind(id:String)->String:
	if id=="eos_008":return "burrow"
	if id=="eos_477":return "vanish"
	if id=="eos_156":return "dive"
	if id in TILE_CAST_AIR:return "air"
	if id in TILE_CAST_GROUND:return "ground"
	return ""

func tile_cast_route(event:Dictionary)->Array:
	var source:Vector2i=event.from
	var target:Vector2i=event.to
	var points:Array=[pos(source)]
	for cell in event.get("path",[]):
		if cell is Vector2i and pos(cell)!=points[-1]:points.append(pos(cell))
		if cell==target:break
	if points[-1]!=pos(target):points.append(pos(target))
	return points

# Full path from origin to target at the same impact clock as the FX, then
# reverse the path. Travel is visual: it never picks up loot or consumes turns.
func tile_cast_sample(points:Array,kind:String,progress:float,impact:float,airborne_start:bool=false,metrics:PackedFloat64Array=PackedFloat64Array())->Dictionary:
	if metrics.size()!=points.size():metrics=combat_path_metrics(points)
	var p:float=clampf(progress,0.0,1.0)
	var peak:float=clampf(impact,.12,.88)
	var returning:bool=p>peak
	var linear:float=clampf(p/peak if not returning else (1.0-p)/(1.0-peak),0.0,1.0)
	# Ease both legs at their endpoints, preserving the exact impact clock.
	var u:float=smoothstep(0.0,1.0,linear)
	var location:Vector3=combat_path_sample(points,u,metrics)
	var lo:Vector3=combat_path_sample(points,maxf(0.0,u-.015),metrics)
	var hi:Vector3=combat_path_sample(points,minf(1.0,u+.015),metrics)
	var motion:Vector3=(hi-lo).normalized()
	if returning:motion=-motion
	var arc:float=sin(PI*u)
	var height:float=0.0
	var visible:bool=true
	match kind:
		"air":
			height=1.25*arc
			if not returning and airborne_start:height+=.95*(1.0-u)
		"burrow","dive":
			# Distinct soil/water depth and resurfacing arcs.
			visible=returning or u>=.76
			height=(.28 if kind=="dive" else .45)*arc if returning else -(.24 if kind=="dive" else .38)*(1.0-u)
		"vanish":
			visible=returning or u>=.76
			height=.35*arc if returning else 0.0
		_:height=.12*arc
	return {"position":location+Vector3.UP*height,"motion":motion,"visible":visible,"returning":returning,"height":height,"path_progress":u}

func tile_cast_active()->bool:
	return attack_time>0.0 and not player_tile_cast.is_empty()

func finish_tile_cast()->void:
	if player_tile_cast.is_empty():return
	var points:Array=player_tile_cast.points
	if points.size()>1:
		var direction:Vector3=points[0]-points[1]
		facing=Rules.aim8(Vector2(direction.x,direction.z))
		lab_update_aim()
		if is_instance_valid(aim_button):aim_button.text="Aim "+["↑","↗","→","↘","↓","↙","←","↖"][maxi(0,Rules.DIR8.find(facing))]
	player_tile_cast.clear()

func begin_player_cast_pose(event:Dictionary,age:float=0.0)->void:
	var sample:=player_cast_sample(str(event.fx),event.from,event.to,age)
	regular_strike_pose=str(event.fx)=="basic_strike";empty_strike_pose=false
	player_cast_duration=float(sample.duration);player_cast_mode=str(sample.role)
	attack_time=float(sample.remaining);player_cast_motion=str(sample.motion)
	player_cast_impact=float(sample.impact);player_impact_delay=float(sample.impact_delay)
	player_cast_waves=caster_wave_times(event,player_cast_duration,player_cast_impact)
	attack_direction=sample.direction
	player_tile_cast.clear()
	var tile_kind:String=tile_cast_kind(str(event.fx))
	if not tile_kind.is_empty() and event.from!=event.to:
		player_tile_cast={"kind":tile_kind,"points":tile_cast_route(event)}
	if is_instance_valid(attack_fx):
		attack_fx.position=pos(event.to)+Vector3(0,.24,0)
		attack_fx.visible=player_impact_delay<=0.0 and attack_time>0.0

func delayed_cast_can_replay(duration:float,age:float,dt:float,body_remaining:float)->bool:
	# Compare the previous animation against the actual launch instant, not the end of the frame.
	return age<duration and body_remaining<=maxf(0.0,dt-age)+.0001

# Compact pending casts once rather than shifting the queue on every expiry.
# The bounded due list is chronological, with FIFO for identical launch times.
func collect_due_combat_casts(dt:float)->void:
	fx_due_delayed_casts.clear()
	var write_index:int=0
	for read_index in range(delayed_combat_fx.size()):
		var item:Dictionary=delayed_combat_fx[read_index]
		item.delay-=dt
		if float(item.delay)<=0.0:
			var insert_at:int=fx_due_delayed_casts.size()
			while insert_at>0 and float(fx_due_delayed_casts[insert_at-1].delay)>float(item.delay):
				insert_at-=1
			fx_due_delayed_casts.insert(insert_at,item)
		else:
			if write_index!=read_index:delayed_combat_fx[write_index]=item
			write_index+=1
	delayed_combat_fx.resize(write_index)

func update_delayed_combat_fx(dt:float)->void:
	if delayed_combat_fx.is_empty():return
	collect_due_combat_casts(dt)
	for item in fx_due_delayed_casts:
		# This frame's elapsed fraction is applied once, not twice.
		if not is_instance_valid(combat_fx_root):continue
		var age:float=maxf(0.0,-float(item.delay))
		combat_fx_spawn(item.event,age)
		if not combat_bursts.is_empty():combat_bursts[-1].age=age-dt
		# Do not turn a moved companion toward a historical origin, or interrupt
		# a newer attack/charge. The independently recorded world FX still plays.
		if delayed_cast_can_replay(float(combat_profile(str(item.event.fx)).duration),age,dt,attack_time) and run!=null and run.player==item.event.from and run.charge_phase.is_empty():
			release_charge_phase=""
			begin_player_cast_pose(item.event,age-dt)
	fx_due_delayed_casts.clear()

# Rendering visits newer bursts first, but the last actual impact wins the hurt pose.
# A visual budget eviction must not silently cancel a pending hit or sound.
# Each wave is one recorded attempt per affected tile, not a guessed hit count.
func cast_impact_wave_count(results:Dictionary)->int:
	var count:int=1
	for tile in results:
		count=maxi(count,mini(12,results[tile].get("attempts",[]).size()))
	return count

func cast_impact_waves(results:Dictionary)->Array[Dictionary]:
	var count:int=cast_impact_wave_count(results)
	if count==1:return [results]
	var waves:Array[Dictionary]=[]
	for i in range(count):
		var wave:Dictionary={}
		for tile in results:
			var row:Dictionary=results[tile]
			var attempts:Array=row.get("attempts",[])
			if attempts.is_empty():
				if i==0:wave[tile]=row
				continue
			if i>=attempts.size():continue
			var attempt:Dictionary=attempts[i].duplicate()
			if i==attempts.size()-1:
				var has_timed_status:bool=false
				for entry in attempts:
					if entry.has("status_changed"):has_timed_status=true;break
				if row.has("status") and not has_timed_status:attempt["status"]=row.status
				if row.has("heal"):attempt["heal"]=row.heal
			wave[tile]=attempt
		waves.append(wave)
	return waves

# The same attempt ledger drives world FX and caster pose. Split only the
# cosmetic body clock; movement routes and gameplay remain on global time.
func caster_wave_times(event:Dictionary,duration:float,impact:float)->Array[float]:
	var count:int=cast_impact_wave_count(event.get("results",{}))
	if count<2:return []
	return reaction_times(duration,impact,count)

func caster_wave_progress(age:float,duration:float,impact:float,times:Array)->float:
	var t:float=clampf(age,0.0,maxf(.001,duration))
	var peak:float=clampf(impact,.12,.88)
	if times.size()<2:return clampf(t/maxf(.001,duration),0.0,1.0)
	var index:int=0
	while index+1<times.size() and t>(float(times[index])+float(times[index+1]))*.5:
		index+=1
	var contact:float=float(times[index])
	var start:float=0.0 if index==0 else (float(times[index-1])+contact)*.5
	var finish:float=duration if index==times.size()-1 else (contact+float(times[index+1]))*.5
	if t<=contact:return peak*clampf((t-start)/maxf(.000001,contact-start),0.0,1.0)
	return peak+(1.0-peak)*clampf((t-contact)/maxf(.000001,finish-contact),0.0,1.0)

func confirmed_wave_times(results:Dictionary,tile:Vector2i,duration:float,impact:float)->Array[float]:
	var waves:=cast_impact_waves(results)
	var times:=reaction_times(duration,impact,waves.size())
	var confirmed:Array[float]=[]
	for i in range(waves.size()):
		if int(waves[i].get(tile,{}).get("damage",0))>0:confirmed.append(times[i])
	return confirmed

# V20.2: newly dispatched visuals already carry elapsed sub-frame time.
func combat_visual_age(age:float,dt:float,fresh:bool)->float:
	return maxf(0.0,age)+(0.0 if fresh else maxf(0.0,dt))

func combat_ground_shake_at_age(age:float)->float:
	return maxf(0.0,.22-maxf(0.0,age)*3.0)

# Prefer actual critical/damaging contacts over a closer status-only tile.
func combat_wave_audio_target(wave:Dictionary,origin:Vector3)->Vector3:
	var best:Vector3=origin
	var best_rank:int=0
	var nearest:float=INF
	for tile in wave:
		var row:Dictionary=wave[tile]
		var amount:int=int(row.get("damage",0))
		var rank:int=3 if amount>0 and int(row.get("crit",0))>0 else 2 if amount>0 else 1 if int(row.get("effects",0))+int(row.get("heal",0))>0 else 0
		if rank==0:continue
		var point:Vector3=pos(tile)+Vector3.UP*origin.y
		var distance:float=point.distance_squared_to(origin)
		if rank>best_rank or (rank==best_rank and distance<nearest):
			best=point
			best_rank=rank
			nearest=distance
	return best

func dispatch_cast_waves(burst:Dictionary)->void:
	var waves:Array=burst.get("impact_waves",[])
	var times:Array=burst.get("impact_times",[])
	var cursor:int=int(burst.get("impact_cursor",0))
	var age_now:float=float(burst.age)
	if cursor>=times.size() or age_now<float(times[cursor]):
		if not burst.has("impact_cursor"):burst["impact_cursor"]=cursor
		return
	var move_id:String=str(burst.id)
	var move:Dictionary=Rules.MOVE_LIBRARY[move_id] if Rules.MOVE_LIBRARY.has(move_id) else Rules.DEV_NATIVE_MOVES.get(move_id,{})
	while cursor<times.size() and age_now>=float(times[cursor]):
		var wave:Dictionary=waves[cursor]
		var wave_age:float=maxf(0.0,age_now-float(times[cursor]))
		show_cast_results(wave,wave_age)
		ultra_impact_residue(burst,wave,cursor==0,wave_age)
		var audible:bool=wave.is_empty() and cursor==0
		var target:Vector3=combat_wave_audio_target(wave,burst.points[-1])
		var strongest:int=0
		var critical:bool=false
		var status_cues:Dictionary={}
		var blocked:bool=false
		for tile in wave:
			var row:Dictionary=wave[tile]
			var amount:int=int(row.get("damage",0))
			var kind:String=combat_status_audio_kind(move,row)
			if not kind.is_empty() and not status_cues.has(kind):status_cues[kind]=pos(tile)+Vector3.UP*target.y
			blocked=blocked or int(row.get("blocked",0))>0
			strongest=maxi(strongest,amount)
			critical=critical or (amount>0 and int(row.get("crit",0))>0)
			if amount+int(row.get("effects",0))+int(row.get("heal",0))>0:
				audible=true
		# Do not emit a damage thump for a status effect or an explicit miss.
		var audio_age:float=wave_age
		if audio_age<.14:
			if wave.is_empty() and cursor==0 and burst.get("lab_preview",false):
				# Authored contact sound, without fake hit results or damage to gameplay.
				play_combat_sound(str(burst.id),"status" if str(move.get("category",""))=="status" else "impact",target,false,audio_age)
			elif strongest>0 or (wave.is_empty() and cursor==0 and int(burst.get("damage",0))>0):
				play_combat_sound(str(burst.id),"impact",target,critical,audio_age)
			elif status_cues.is_empty() and audible and not wave.is_empty():play_combat_sound(str(burst.id),"status",target,false,audio_age)
			elif status_cues.is_empty() and not wave.is_empty():play_combat_sound(str(burst.id),"status_blocked" if blocked else "miss",target,false,audio_age)
			# Bound layered effects to two distinct confirmed motifs per wave.
			var status_count:int=0
			for kind in status_cues:
				if status_count>=2:break
				play_combat_sound(str(burst.id),"status_"+str(kind),status_cues[kind],false,audio_age)
				status_count+=1
		fx_dispatched_waves+=1
		if strongest>0 or (wave.is_empty() and cursor==0 and int(burst.get("damage",0))>0):
			fx_dispatched_damage_waves+=1
			queue_contact_camera(burst.points[0],target,critical,wave_age)
		elif not audible and not wave.is_empty() and not blocked:fx_dispatched_miss_waves+=1
		cursor+=1
	burst["impact_cursor"]=cursor

# A subtle directional impulse only on confirmed damage; no camera zoom,
# no hit-stop and no re-centering on the enemy's logical tile.
func contact_camera_sample(progress:float)->float:
	var t:float=clampf(progress,0.0,1.0)
	return (1.0-t)*(1.0-t)*sin(t*TAU*1.25)

func queue_contact_camera(source:Vector3,target:Vector3,critical:bool,age:float)->void:
	if age>=.18 or age>fx_contact_camera_age:return
	var direction:=Vector3(target.x-source.x,0,target.z-source.z).normalized()
	if direction.length_squared()<.0001:return
	var impulse:=direction*(.065 if critical else .038)
	# Concurrent waves can share an exact contact time. Prefer the critical
	# impulse, then a canonical direction, independent of active/retired order.
	if age==fx_contact_camera_age:
		var strength:float=impulse.length_squared()
		var previous:float=fx_contact_camera.length_squared()
		if not is_equal_approx(strength,previous):
			if strength<previous:return
		elif impulse.x<fx_contact_camera.x or (impulse.x==fx_contact_camera.x and impulse.z<=fx_contact_camera.z):
			return
	fx_contact_camera=impulse
	fx_contact_camera_age=age

func cast_has_pending_events(burst:Dictionary)->bool:
	return int(burst.get("impact_cursor",0))<burst.get("impact_times",[]).size() or int(burst.get("environment_audio_cursor",0))<burst.get("environment_audio",[]).size()

func retire_combat_burst(burst:Dictionary)->void:
	if not cast_has_pending_events(burst):return
	var record:Dictionary={"id":burst.id,"age":burst.age,"duration":burst.duration,"profile":burst.profile,"points":burst.points,"path_metrics":burst.get("path_metrics",PackedFloat64Array()),"environment_audio":burst.get("environment_audio",[]),"environment_audio_cursor":burst.get("environment_audio_cursor",0),"target_player":burst.get("target_player",false),"damage":burst.get("damage",0),"results":burst.get("results",{}).duplicate(true),"impact_waves":burst.impact_waves,"impact_times":burst.impact_times,"impact_cursor":burst.impact_cursor,"impacted":burst.impacted}
	if retired_impacts.size()>=RETIRED_IMPACT_CAP:
		var replace_index:int=-1
		for i in range(retired_impacts.size()):
			if not retired_impacts[i].target_player or int(retired_impacts[i].damage)<=0:
				replace_index=i;break
		if replace_index<0:
			if not record.target_player or int(record.damage)<=0:
				fx_retired_dropped+=1
				return
			replace_index=0
		fx_retired_dropped+=1
		retired_impacts.remove_at(replace_index)
	retired_impacts.append(record)

func update_retired_impacts(dt:float)->Dictionary:
	var latest:Dictionary={}
	for i in range(retired_impacts.size()-1,-1,-1):
		var record:Dictionary=retired_impacts[i]
		record.age+=dt
		var previous_cursor:int=int(record.get("impact_cursor",0))
		dispatch_cast_waves(record)
		var previous_environment:int=int(record.get("environment_audio_cursor",0))
		dispatch_environment_audio(record)
		fx_retired_environment_cues+=int(record.get("environment_audio_cursor",0))-previous_environment
		latest=latest_player_impact(latest,record,previous_cursor)
		if not bool(record.impacted) and float(record.age)>=float(record.duration)*float(record.profile.impact):
			record.impacted=true
			if str(record.profile.role) in ["ground","earth_quake","earth_magnitude","earth_fissure"]:fx_ground_shake=maxf(fx_ground_shake,combat_ground_shake_at_age(float(record.age)-float(record.duration)*float(record.profile.impact)))
		if not cast_has_pending_events(record):retired_impacts.remove_at(i)
	return latest

# A player reaction belongs to the newest newly dispatched damaging attempt,
# never the aggregate cast damage or an earlier missed attempt.
func latest_player_impact(current:Dictionary,burst:Dictionary,previous_cursor:int=0)->Dictionary:
	if not bool(burst.get("target_player",false)):return current
	var waves:Array=burst.get("impact_waves",[])
	var times:Array=burst.get("impact_times",[])
	var cursor:int=mini(int(burst.get("impact_cursor",0)),mini(waves.size(),times.size()))
	if cursor<=maxi(0,previous_cursor):return current
	var target:Vector3=burst.points[-1]
	var tile:=Vector2i(roundi(target.x/1.4),roundi(target.z/1.4))
	for index in range(cursor-1,maxi(0,previous_cursor)-1,-1):
		var wave:Dictionary=waves[index]
		var row:Dictionary=wave.get(tile,{})
		var amount:int=int(row.get("damage",0))
		if wave.is_empty() and index==0:amount=int(burst.get("damage",0))
		if amount<=0:continue
		var age:float=maxf(0.0,float(burst.age)-float(times[index]))
		if age>=.24 or (not current.is_empty() and age>float(current.age)):return current
		var direction:=Vector3(target.x-burst.points[0].x,0.0,target.z-burst.points[0].z).normalized()
		var critical:bool=int(row.get("crit",0))>0
		# Same-time hits share one body reaction: critical, damage, direction.
		# Do not let reverse visual traversal decide which hit the player sees.
		if not current.is_empty() and age==float(current.age):
			var old_critical:bool=bool(current.get("critical",false))
			var old_damage:int=int(current.get("damage",0))
			var old_direction:Vector3=current.direction
			if critical!=old_critical:
				if not critical:continue
			elif amount!=old_damage:
				if amount<old_damage:continue
			elif direction.x<old_direction.x or (direction.x==old_direction.x and direction.z<=old_direction.z):continue
		current={"age":age,"direction":direction,"critical":critical,"damage":amount}
		# Inspect equal-time attempts as well; older attempts cannot replace it.
	return current

# Fair streaming allocation: unused slots flow to the remaining casts.
# Only the visual pool is shared; damage, impacts and sound never wait.
func cast_particle_quota(used:int,capacity:int,remaining:int)->int:
	return maxi(0,capacity-used)/maxi(1,remaining)

# A sustained frame-time threshold with asymmetric recovery prevents flicker.
# Resume/loading spikes are ignored; the effect tier is not a gameplay setting.
func update_fx_performance(dt:float,combat_active:bool=false)->void:
	if not is_finite(dt) or dt<=0.0 or dt>.25:
		fx_pressure_age=0.0;fx_recovery_age=0.0
		# Old frame pressure cannot be carried across a suspension/loading gap.
		if dt>.25:fx_frame_average=1.0/60.0
		return
	if fx_performance_grace>0.0:
		fx_performance_grace=maxf(0.0,fx_performance_grace-dt)
		return
	fx_frame_average=lerpf(fx_frame_average,dt,1.0-exp(-dt*3.0))
	var pressure_threshold:float=.024 if fx_performance_tier==0 else .033
	var recovery_threshold:float=.020 if fx_performance_tier==1 else .026
	if fx_performance_tier<2 and fx_frame_average>pressure_threshold:
		fx_pressure_age+=dt;fx_recovery_age=0.0
		if fx_pressure_age>=1.0:
			fx_performance_tier+=1;fx_pressure_age=0.0
	elif fx_performance_tier>0 and fx_frame_average<recovery_threshold:
		fx_recovery_age+=dt;fx_pressure_age=0.0
		# Restore at a quiet boundary when possible, but never hold a healthy
		# device in a reduced tier more than one extra second per recovery.
		if fx_recovery_age>=4.0 and (not combat_active or fx_recovery_age>=5.0):
			fx_performance_tier-=1;fx_recovery_age=0.0
	else:
		fx_pressure_age=0.0;fx_recovery_age=0.0

func residue_particle_count()->int:
	return 4 if fx_performance_tier==0 else 3 if fx_performance_tier==1 else 2

# Preserve the original triangle winding, color interpolation and separate
# alpha/additive materials while submitting compact indexed arrays in bulk.
# Every ribbon/arc segment is the same indexed quad. Build the bounded
# prefix once, then copy only the exact active topology at submission.
func warm_fx_quad_indices()->void:
	if not fx_quad_index_prefix.is_empty():return
	var capacity:int=maxi(1001,int(FX_TRAIL_VERTEX_CAP/6))
	fx_quad_index_prefix.resize(capacity*6)
	for quad in range(capacity):
		var base:int=quad*4
		var offset:int=quad*6
		fx_quad_index_prefix[offset]=base
		fx_quad_index_prefix[offset+1]=base+1
		fx_quad_index_prefix[offset+2]=base+2
		fx_quad_index_prefix[offset+3]=base
		fx_quad_index_prefix[offset+4]=base+2
		fx_quad_index_prefix[offset+5]=base+3

func fx_quad_indices(vertex_count:int)->PackedInt32Array:
	if vertex_count<=0:return PackedInt32Array()
	warm_fx_quad_indices()
	var count:int=int(vertex_count/4)*6
	if count<=fx_quad_index_prefix.size():return fx_quad_index_prefix.slice(0,count)
	# Preserve the full topology even if a future effect exceeds today's cap.
	var indices:=fx_quad_index_prefix.duplicate()
	for base in range(int(indices.size()/6)*4,vertex_count,4):
		indices.append(base);indices.append(base+1);indices.append(base+2)
		indices.append(base);indices.append(base+2);indices.append(base+3)
	return indices

func commit_fx_geometry(mesh_value:ArrayMesh,mat:Material,positions:PackedVector3Array,colors:PackedColorArray,indices:PackedInt32Array,material_on_node:bool=false)->bool:
	if positions.is_empty() or indices.is_empty():return false
	var arrays:Array=[]
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX]=positions
	arrays[Mesh.ARRAY_COLOR]=colors
	arrays[Mesh.ARRAY_INDEX]=indices
	mesh_value.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,arrays)
	if not material_on_node:mesh_value.surface_set_material(0,mat)
	fx_geometry_batch_submits+=1
	fx_geometry_unique_vertices+=positions.size()
	fx_geometry_triangle_indices+=indices.size()
	return true

# Only flat ImageTexture sprites are eligible: their world transform is
# already exact. Billboards and AtlasTexture regions stay on the original path.
# Sweep the projected x intervals; only pairs sharing an x interval can
# overlap. Noneligible sprites still block eligible ones, including touching edges.
func particle_batch_groups(rects:Array[Rect2],keys:Array[int])->Array:
	if rects.size()!=keys.size():return []
	var frequency:Dictionary={}
	for key in keys:
		if key>=0:frequency[key]=int(frequency.get(key,0))+1
	var candidates:Array[bool]=[]
	var order:Array[int]=[]
	for i in range(keys.size()):
		candidates.append(keys[i]>=0 and int(frequency.get(keys[i],0))>=FX_PARTICLE_BATCH_MIN)
		order.append(i)
	if not candidates.has(true):return []
	order.sort_custom(func(a:int,b:int)->bool:
		if rects[a].position.x==rects[b].position.x:return a<b
		return rects[a].position.x<rects[b].position.x)
	for left in range(order.size()):
		var a:int=order[left]
		for right in range(left+1,order.size()):
			var b:int=order[right]
			if rects[b].position.x>rects[a].end.x:break
			if not candidates[a] and not candidates[b]:continue
			fx_particle_overlap_tests+=1
			if rects[a].intersects(rects[b],true):
				candidates[a]=false
				candidates[b]=false
	var by_texture:Dictionary={}
	for i in range(keys.size()):
		if not candidates[i]:continue
		if not by_texture.has(keys[i]):by_texture[keys[i]]=[]
		by_texture[keys[i]].append(i)
	var groups:Array=[]
	for key in by_texture:
		if by_texture[key].size()>=FX_PARTICLE_BATCH_MIN:groups.append(by_texture[key])
	groups.sort_custom(func(a:Array,b:Array)->bool:
		if a.size()==b.size():return int(a[0])<int(b[0])
		return a.size()>b.size())
	return groups.slice(0,FX_PARTICLE_BATCH_CAP)

func particle_batch_preflight(keys:Array[int])->bool:
	var frequency:Dictionary={}
	for key in keys:
		if key<0:continue
		frequency[key]=int(frequency.get(key,0))+1
		if int(frequency[key])>=FX_PARTICLE_BATCH_MIN:return true
	return false

# Back off only the optional batching path, never effects or particle count.
# Reprobe periodically even after a long crowded sequence.
func particle_batch_adapt(saved:int)->void:
	if saved>0:
		fx_particle_no_gain_frames=0
		fx_particle_cooldown=0
	else:
		fx_particle_no_gain_frames+=1
		if fx_particle_no_gain_frames>=FX_PARTICLE_NO_GAIN_LIMIT:
			fx_particle_no_gain_frames=0
			fx_particle_cooldown=FX_PARTICLE_PROBE_INTERVAL

func particle_screen_rect(particle:Sprite3D)->Rect2:
	var texture:Texture2D=particle.texture
	var half:=texture.get_size()*particle.pixel_size*.5
	var center:=particle.global_position
	var basis:=particle.global_basis
	if particle.billboard!=BaseMaterial3D.BILLBOARD_DISABLED:
		# Conservative sphere bound for billboard sprites, regardless of facing.
		var radius:float=half.length()*maxf(basis.x.length(),maxf(basis.y.length(),basis.z.length()))
		var rect:=Rect2(camera.unproject_position(center),Vector2.ZERO)
		for x in [-1.0,1.0]:
			for y in [-1.0,1.0]:
				for z in [-1.0,1.0]:
					var point:=center+Vector3(x,y,z)*radius
					if camera.is_position_behind(point):return camera.get_viewport().get_visible_rect()
					rect=rect.expand(camera.unproject_position(point))
		return rect.grow(2.0)
	var bounds:=Rect2(camera.unproject_position(center),Vector2.ZERO)
	for x in [-1.0,1.0]:
		for y in [-1.0,1.0]:
			var point:=center+basis*Vector3(x*half.x,y*half.y,0.0)
			if camera.is_position_behind(point):return camera.get_viewport().get_visible_rect()
			bounds=bounds.expand(camera.unproject_position(point))
	return bounds.grow(2.0)

func ensure_particle_batch(slot:int)->MultiMeshInstance3D:
	while fx_particle_batches.size()<=slot:
		var material:=StandardMaterial3D.new()
		material.shading_mode=BaseMaterial3D.SHADING_MODE_UNSHADED
		material.transparency=BaseMaterial3D.TRANSPARENCY_ALPHA
		material.cull_mode=BaseMaterial3D.CULL_DISABLED
		material.vertex_color_use_as_albedo=true
		material.texture_filter=BaseMaterial3D.TEXTURE_FILTER_NEAREST
		var quad:=QuadMesh.new()
		quad.size=Vector2.ONE
		quad.material=material
		var multimesh:=MultiMesh.new()
		multimesh.transform_format=MultiMesh.TRANSFORM_3D
		multimesh.use_colors=true
		multimesh.mesh=quad
		multimesh.instance_count=FX_PARTICLE_CAP+LIVING_PARTICLE_CAP
		multimesh.visible_instance_count=0
		var batch:=MultiMeshInstance3D.new()
		batch.multimesh=multimesh
		batch.cast_shadow=GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		combat_fx_root.add_child(batch)
		batch.hide()
		fx_particle_batches.append(batch)
		fx_particle_batch_materials.append(material)
	return fx_particle_batches[slot]

# Hide only the retired suffix of a previously submitted prefix. Pooled
# sprites start hidden, and optional batching only hides submitted sprites.
func finish_particle_range(base:int,used:int,previous:int,capacity:int)->int:
	var available:int=maxi(0,mini(capacity,combat_particles.size()-base))
	var current:int=clampi(used,0,available)
	for index in range(base+current,base+clampi(previous,0,available)):
		if combat_particles[index].visible:combat_particles[index].hide()
	return current

func active_particle_pool_index(index:int)->int:
	return index if index<fx_cast_particles_used else FX_PARTICLE_CAP+index-fx_cast_particles_used

func update_particle_batches()->void:
	fx_particle_batch_used=0
	fx_particle_batched_count=0
	var can_batch:bool=fx_particle_batch_enabled and is_instance_valid(camera) and camera.is_inside_tree()
	if can_batch and fx_particle_cooldown>0:
		fx_particle_cooldown-=1
		fx_particle_cooldown_skips+=1
		can_batch=false
	if can_batch:
		var start:int=Time.get_ticks_usec()
		var visible:Array[Sprite3D]=[]
		var rects:Array[Rect2]=[]
		var keys:Array[int]=[]
		for index in range(fx_cast_particles_used+fx_living_particles_used):
			var particle:Sprite3D=combat_particles[active_particle_pool_index(index)]
			if not particle.visible or particle.texture==null:continue
			visible.append(particle)
			var eligible:bool=particle.billboard==BaseMaterial3D.BILLBOARD_DISABLED and particle.texture is ImageTexture and particle.centered and particle.offset==Vector2.ZERO and not camera.is_position_behind(particle.global_position)
			keys.append(particle.texture.get_instance_id() if eligible else -1)
		var groups:Array=[]
		if particle_batch_preflight(keys):
			for particle in visible:rects.append(particle_screen_rect(particle))
			groups=particle_batch_groups(rects,keys)
		else:fx_particle_preflight_skips+=1
		for group in groups:
			var slot:int=fx_particle_batch_used
			var batch:=ensure_particle_batch(slot)
			var first:Sprite3D=visible[group[0]]
			var material:StandardMaterial3D=fx_particle_batch_materials[slot]
			if material.albedo_texture!=first.texture:material.albedo_texture=first.texture
			var mesh_value:MultiMesh=batch.multimesh
			for i in range(group.size()):
				var particle:Sprite3D=visible[group[i]]
				var size:=particle.texture.get_size()*particle.pixel_size
				var basis:=particle.basis*Basis.from_scale(Vector3(size.x,size.y,1.0))
				mesh_value.set_instance_transform(i,Transform3D(basis,particle.position))
				mesh_value.set_instance_color(i,particle.modulate)
				particle.hide()
			if mesh_value.visible_instance_count!=group.size():mesh_value.visible_instance_count=group.size()
			if not batch.visible:batch.show()
			fx_particle_batch_used+=1
			fx_particle_batched_count+=group.size()
			fx_particle_batches_total+=1
			fx_particle_draws_saved+=group.size()-1
		particle_batch_adapt(fx_particle_batched_count-fx_particle_batch_used)
		fx_particle_batch_usec+=Time.get_ticks_usec()-start
	for i in range(fx_particle_batch_used,fx_particle_batches.size()):
		if fx_particle_batches[i].visible:
			fx_particle_batches[i].hide()
			fx_particle_batches[i].multimesh.visible_instance_count=0

# Exact prefix partition used by the authored particle branches. Electric
# historically includes roles with or without an underscore.
# Fixed angular layouts are identical for every cast with the same count.
# Float64 preserves the original arithmetic; animated angles remain dynamic.
var fx_particle_layouts:Array[PackedFloat64Array]=[]
func build_particle_layout(count:int)->PackedFloat64Array:
	var layout:=PackedFloat64Array()
	layout.resize(count*4)
	var denominator:int=maxi(1,count-1)
	for j in range(count):
		var f:float=float(j)/denominator
		var angle:float=f*TAU+float(j)*2.399
		var offset:int=j*4
		layout[offset]=f
		layout[offset+1]=angle
		layout[offset+2]=cos(angle)
		layout[offset+3]=sin(angle)
	return layout

func warm_particle_layouts()->void:
	if not fx_particle_layouts.is_empty():return
	for count in range(27):
		fx_particle_layouts.append(build_particle_layout(count))

func combat_particle_layout(count:int)->PackedFloat64Array:
	if fx_particle_layouts.is_empty():warm_particle_layouts()
	if count>=0 and count<fx_particle_layouts.size():return fx_particle_layouts[count]
	return build_particle_layout(maxi(0,count))

func combat_particle_family(role:String)->String:
	if role.begins_with("electric"):return "electric"
	var separator:int=role.find("_")
	return role.substr(0,separator+1) if separator>=0 else ""

# The first quiet frame after combat still takes the full cleanup path.
# Status particles, text and camera clocks remain independent of active casts.
func combat_fx_can_idle()->bool:
	return combat_bursts.is_empty() and delayed_combat_fx.is_empty() and retired_impacts.is_empty() and fx_reactions.is_empty() and fx_reaction_sparks.is_empty() and fx_residues.is_empty() and (run==null or run.charge_phase.is_empty()) and fx_cast_particles_used==0 and fx_lights_used==0 and fx_halos_used==0 and not fx_trail_had_geometry and not fx_arc_had_geometry and not fx_trail_started and fx_arc_segments==0 and not fx_collect_audio and not fx_flushing_audio and fx_frame_audio.is_empty()

func combat_fx_update(dt:float)->void:
	if combat_fx_can_idle():
		update_cast_text(dt)
		fx_ground_shake=maxf(0.0,fx_ground_shake-dt*3.0)
		fx_contact_camera_age=minf(1.0,fx_contact_camera_age+dt)
		living_status_fx()
		update_particle_batches()
		return
	begin_combat_audio_frame()
	update_cast_text(dt)
	var latest_hit:Dictionary={}
	update_delayed_combat_fx(dt)
	var used:int=0
	fx_lights_used=0;fx_halos_used=0;fx_light_scores.clear()
	fx_trail_vertices=0;fx_trail_started=false
	fx_trail_positions.clear();fx_trail_colors.clear()
	if fx_trail_had_geometry and is_instance_valid(fx_trail_mesh):fx_trail_mesh.clear_surfaces()
	fx_trail_had_geometry=false
	update_combat_reactions(dt)
	fx_ground_shake=maxf(0.0,fx_ground_shake-dt*3.0)
	fx_contact_camera_age=minf(1.0,fx_contact_camera_age+dt)
	latest_hit=update_retired_impacts(dt)
	fx_arc_segments=0
	fx_arc_positions.clear();fx_arc_colors.clear()
	if fx_arc_had_geometry and is_instance_valid(fx_arc_mesh):fx_arc_mesh.clear_surfaces()
	fx_arc_had_geometry=false
	var charging:bool=run!=null and not run.charge_phase.is_empty()
	var remaining_casts:int=0
	for pending in combat_bursts:
		if float(pending.age)+dt<float(pending.duration):remaining_casts+=1
	var crowded:bool=remaining_casts>1
	# A crowded frame keeps slots for real hit reactions and charging.
	var reserve:int=24 if crowded else 0
	if charging:reserve=maxi(reserve,12)
	if not fx_reaction_sparks.is_empty():reserve=maxi(reserve,16)
	if not fx_residues.is_empty():reserve=maxi(reserve,12)
	var cast_capacity:int=FX_PARTICLE_CAP-reserve
	fx_cast_particle_limit=FX_PARTICLE_CAP
	for k in range(combat_bursts.size()-1,-1,-1):
		var burst:Dictionary=combat_bursts[k]
		burst.age+=dt
		var t:float=float(burst.age)/float(burst.duration)
		var profile:Dictionary=burst.profile
		var previous_cursor:int=int(burst.get("impact_cursor",0))
		dispatch_cast_waves(burst)
		dispatch_environment_audio(burst)
		latest_hit=latest_player_impact(latest_hit,burst,previous_cursor)
		if not burst.impacted and t>=float(profile.impact):
			burst.impacted=true
			if str(profile.role) in ["ground","earth_quake","earth_magnitude","earth_fissure"]:fx_ground_shake=maxf(fx_ground_shake,combat_ground_shake_at_age(float(burst.age)-float(burst.duration)*float(profile.impact)))
		if t>=1.0:
			# Keep any future cue independently of the expired visual lifetime.
			retire_combat_burst(burst)
			combat_bursts.remove_at(k);continue
		var share:int=cast_particle_quota(used,cast_capacity,remaining_casts)
		remaining_casts=maxi(0,remaining_casts-1)
		fx_cast_particle_limit=used+share
		cinematic_cast_enhancement(burst,t)
		ultra_attack_ribbons(burst,t)
		var mode:String=burst.mode
		var frame:int=clampi(int(t*FX_FRAME_COUNT),0,FX_FRAME_COUNT-1)
		# Hold the exact texture for the current authored frame, even if the
		# shared cache evicts it during a simultaneous multi-target attack.
		if int(burst.get("cached_frame",-1))!=frame:
			burst["cached_frame"]=frame
			burst["texture"]=combat_cast_frame(str(burst.id),burst.frames,frame)
		var animated:Texture2D=burst.texture
		var points:Array=burst.points
		var path_metrics:PackedFloat64Array=burst.get("path_metrics",PackedFloat64Array())
		var tiles:Array=burst.tiles
		if str(profile.role).begins_with("electric") and t>.08 and t<.91:
			electric_world_arc(points,t,str(profile.role),tiles,float(profile.impact),path_metrics)
		elif str(profile.role) in ["lash","ground","grass_vine","grass_whip","grass_needle","earth_quake","earth_magnitude","earth_fissure"] and t>.03:
			if profile.role in ["lash","grass_vine","grass_whip","grass_needle"]:vine_world_lash(points,t,profile,str(burst.id),path_metrics)
			else:quake_world_tiles(tiles,t,str(burst.id))
		var cast_role:String=str(profile.role)
		var cast_family:String=combat_particle_family(cast_role)
		var cast_impact:float=float(profile.impact)
		var particle_mode:String=str(profile.mode)
		var particle_tint:=Color(1,1,1,clampf((1.0-t)*3.5,0.0,1.0))
		var count:int=mini(26,6+tiles.size()*2) if mode in ["cloud","wave","fan","web","shards","beam"] else 14
