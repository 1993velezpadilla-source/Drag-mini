		if not actor.get_meta("companion_disguise",false):
			var hit_dir:Vector3=actor.get_meta("enemy_hit_direction",Vector3.ZERO)
			var forward:Vector3=hit_dir.normalized()
			var lateral:=Vector3(-forward.z,0.0,forward.x)
