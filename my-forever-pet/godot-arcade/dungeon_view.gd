	var shadow_position:=Vector3.ZERO
	var shadow_scale:=Vector3.ONE
	var shadow_visible:bool=body_visible
	if shadow!=null:
		var parent_lift:float=actor.position.y if actor.get_meta("companion_disguise",false) else 0.0
