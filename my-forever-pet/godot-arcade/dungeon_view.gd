func build_astral_cloud_banks():
	astral_cloud_bounds.clear()
	if region!=2:return
	var parts=rock_parts("res://assets/dungeon_star_cloud_habitat.glb")
	if parts.is_empty():return
	var placements:Array[Transform3D]=[]
