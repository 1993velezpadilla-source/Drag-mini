func emit_trail(tile:Vector2i,dir:Vector2i):
	if not run.cells.has(tile):return
	var side=-1.0 if trail_cursor%2==0 else 1.0
	trail_origins[trail_cursor]=pos(tile)+Vector3(-dir.y*side*.12,.035,dir.x*side*.12)
	trail_angles[trail_cursor]=atan2(float(dir.x),float(dir.y))
	trail_transform_dirty[trail_cursor]=1
	trail_ages[trail_cursor]=0.0;trail_cursor=(trail_cursor+1)%TRAIL_COUNT;trail_emitted+=1
# Forest and astral footprints keep the same transform until expiration.
# Reef rings still expand every frame; overwritten slots always resubmit.
func trail_needs_transform(biome:int,dirty:bool,expired:bool)->bool:
	return biome==1 or dirty or expired

func update_living_ambient(dt:float):
	if ambient_batches.size()!=2 or not is_instance_valid(trail_batch):return
	var delta=clampf(dt,0.0,.25)
	ambient_clock+=delta
	for material in biome_light_materials:set_fx_uniform(material,&"scene_time",ambient_clock)
	var player_center:=pos(run.player)
	var primary_mesh:MultiMesh=ambient_batches[0].multimesh
	var mote_mesh:MultiMesh=ambient_batches[1].multimesh
	var trail_mesh:MultiMesh=trail_batch.multimesh
	var reef_basis:=Basis(Vector3.RIGHT,PI*.30)
	var mote_clock:float=ambient_clock*1.4
	for i in range(ambient_origins.size()):
		ambient_ages[i]+=delta
		var mote=i>=AMBIENT_COUNT
		var duration=5.5+float(i%5)*.37
		if ambient_ages[i]>=duration or ambient_origins[i].distance_squared_to(player_center)>81.0:ambient_spawn_at(i,player_center)
		var age=ambient_ages[i];var phase=age/duration;var seed=float(i)*2.399
		var fade=minf(1.0,minf(phase*7.0,(1.0-phase)*6.0))
		var offset=Vector3(sin(age*.71+seed)*.46,0,cos(age*.57+seed)*.36)
		var size=.12+.035*float(i%4)
		var basis:Basis
		if mote:
			offset.y=.55+.30*sin(age*.8+seed)+phase*.40
			size=.035+.014*float(i%3);fade*=.48+.52*absf(sin(mote_clock+seed))
			if region==0:
				var flash:float=pow(0.5+0.5*sin(ambient_clock*1.7+seed),3.0)
				fade*=.20+.80*flash
				offset.x+=sin(age*.9+seed)*.33
				size*=1.5+flash*.55
			basis=Basis.from_scale(Vector3.ONE*size)
		elif region==0:
			offset.y=3.3-phase*3.15
			# Individual leaves drift with spatially coherent wind, not a shared rotation.
			var breeze:float=sin(ambient_clock*.39+ambient_origins[i].z*.36)
			offset.x+=breeze*phase*.55
			basis=Basis.from_euler(Vector3(age*.8+seed,age*.6,seed+sin(age)*.6+breeze*.22)).scaled(Vector3.ONE*size*1.7)
		elif region==1:
			offset.y=.10+phase*3.0
			basis=reef_basis.scaled(Vector3.ONE*size*(.75+phase*.6))
		else:
			offset.y=.3+phase*2.6
			basis=Basis.from_euler(Vector3(age*.4,seed+age*.6,age*.3)).scaled(Vector3(size*.4,size,size*.4))
		var index=i-AMBIENT_COUNT if mote else i
		var mm:MultiMesh=mote_mesh if mote else primary_mesh
		mm.set_instance_transform(index,Transform3D(basis,ambient_origins[i]+offset))
		mm.set_instance_color(index,Color(1,1,1,fade*(.82 if region==0 and not mote else .70)))
	var life=1.7 if region==1 else 3.2
	for i in range(TRAIL_COUNT):
		if trail_ages[i]>=life:continue
		trail_ages[i]=minf(99.0,trail_ages[i]+delta)
		var fade=clampf(1.0-trail_ages[i]/life,0.0,1.0)
		var scale_value=(.55+trail_ages[i]*.28) if region==1 else .78
		var expired:bool=fade<=0.0
		if expired:scale_value=.001;trail_ages[i]=99.0
		if trail_needs_transform(region,trail_transform_dirty[i]!=0,expired):
			trail_mesh.set_instance_transform(i,Transform3D(Basis(Vector3.UP,trail_angles[i]).scaled(Vector3.ONE*scale_value),trail_origins[i]))
			trail_transform_dirty[i]=0
			world_trail_transform_writes+=1
		else:world_trail_transform_skips+=1
		trail_mesh.set_instance_color(i,Color(1,1,1,fade*.58))
func build_floor():
	var start_usec=Time.get_ticks_usec()
