func strike_available()->bool:
	var active:Button=panel_strike if strike_on_panel else attack_button
	return not notified and not run.finished and is_instance_valid(active) and active.is_visible_in_tree() and not active.disabled and run.charged_move_id.is_empty() and not controls_modal()

func load_control_preferences()->void:
	var prefs:=ConfigFile.new()
	if prefs.load("user://kindria_hud.cfg")!=OK:return
	strike_on_panel=bool(prefs.get_value("combat","strike_on_panel",false))
	movement_joystick=bool(prefs.get_value("combat","movement_joystick",false))
	field_aim_enabled=bool(prefs.get_value("combat","field_aim",false))
	combat_haptics=bool(prefs.get_value("combat","haptics",false))
	strike_opacity=clampf(float(prefs.get_value("combat","strike_opacity",.48)),.25,.85)
	var saved:Variant=prefs.get_value("combat","strike_position",Vector2(.98,.95))
	if saved is Vector2:strike_fraction=saved.clamp(Vector2.ZERO,Vector2.ONE)

func save_control_preferences()->void:
	var prefs:=ConfigFile.new();prefs.load("user://kindria_hud.cfg")
	prefs.set_value("combat","strike_on_panel",strike_on_panel)
	prefs.set_value("combat","movement_joystick",movement_joystick)
	prefs.set_value("combat","field_aim",field_aim_enabled)
	prefs.set_value("combat","haptics",combat_haptics)
	prefs.set_value("combat","strike_opacity",strike_opacity)
	prefs.set_value("combat","strike_position",strike_fraction)
	prefs.save("user://kindria_hud.cfg")

func touch_feedback(button_control:Button,active:bool)->void:
	if is_instance_valid(button_control):button_control.self_modulate=Color(1.22,1.22,1.22,1.0) if active else Color.WHITE

func touch_haptic()->void:
	if not combat_haptics or not OS.has_feature("mobile"):return
	var now:int=Time.get_ticks_msec()
	if now-last_haptic_ms<65:return
	last_haptic_ms=now;Input.vibrate_handheld(12,.35)

func apply_control_preferences()->void:
	path.clear();strike_pending=false;reset_joystick()
	touch_feedback(strike_touch_button,false);strike_touch_button=null
	strike_pointer=-2;field_pointer=-2;field_aiming=false;utility_drag_kind=""
	cancel_native_combat()
	if is_instance_valid(utility_dock):
		# Keep two compact rows in portrait; floating Strike frees width, not another row.
		utility_dock.columns=2
		utility_dock.custom_minimum_size.x=114 if strike_on_panel else 100
	if is_instance_valid(panel_strike):panel_strike.visible=strike_on_panel
	if is_instance_valid(attack_button):attack_button.visible=not strike_on_panel and dungeon_footer.visible
	if is_instance_valid(joystick):joystick.visible=movement_joystick
	position_strike_bubble()

func style_strike_bubble()->void:
	var bg:=hud_base_color().lerp(Color("#176b46"),.32);bg.a=strike_opacity
	var edge:=hud_gold();edge.a=.90
	var frame:=compact_style(bg,edge,26);frame.set_border_width_all(2)
	var pressed_bg:=bg.lightened(.22);pressed_bg.a=minf(1.0,strike_opacity+.25)
	attack_button.add_theme_stylebox_override("normal",frame)
	attack_button.add_theme_stylebox_override("hover",frame)
	attack_button.add_theme_stylebox_override("pressed",compact_style(pressed_bg,edge,26))

func draw_joystick()->void:
	var center:=joystick.size*.5
	var radius:float=minf(center.x,center.y)-5.0
	if radius<=0:return
	var tint:=hud_accent_color()
	joystick.draw_circle(center,radius,Color(hud_base_color(),.75))
	joystick.draw_arc(center,radius,0,TAU,48,Color(tint,.65),1.5,true)
	for i in range(8):
		var d:=Vector2.from_angle(float(i)*TAU/8.0)
		var selected:bool=joy_direction!=Vector2i.ZERO and d.dot(Vector2(joy_direction).normalized())>.98
		joystick.draw_circle(center+d*(radius-5.0),3.5 if selected else 2.0,Color(tint,1.0 if selected else .45))
	joystick.draw_circle(center+joy_knob*radius*.57,radius*.36,Color(tint,.95 if joy_pointer!=-2 else .65))

func reset_joystick()->void:
	joy_pointer=-2;joy_direction=Vector2i.ZERO;joy_knob=Vector2.ZERO
	if is_instance_valid(joystick):joystick.queue_redraw()

func joystick_direction_for(delta:Vector2,radius:float)->Vector2i:
	return Rules.aim8(delta) if delta.length()>maxf(1.0,radius)*.20 else Vector2i.ZERO

func joystick_stable_direction(delta:Vector2,radius:float,previous:Vector2i)->Vector2i:
	var scaled_radius:float=maxf(1.0,radius)
	var threshold:float=.15 if previous!=Vector2i.ZERO else .20
	if delta.length()<=scaled_radius*threshold:return Vector2i.ZERO
	if previous!=Vector2i.ZERO and delta.normalized().dot(Vector2(previous).normalized())>=cos(deg_to_rad(28.0)):return previous
	return Rules.aim8(delta)

func set_joystick_point(point:Vector2)->void:
	var local:=joystick.get_global_transform_with_canvas().affine_inverse()*point
	var delta:=local-joystick.size*.5
	var radius:float=maxf(1.0,minf(joystick.size.x,joystick.size.y)*.5)
	joy_knob=(delta/radius).limit_length(1.0)
	var previous:Vector2i=joy_direction
	joy_direction=joystick_stable_direction(delta,radius,previous)
	if joy_direction!=previous and previous==Vector2i.ZERO and joy_direction!=Vector2i.ZERO:touch_haptic()
	if joy_direction!=Vector2i.ZERO and attack_time<=0.0 and not strike_pending and not hold_active and native_aim_pointer==-2 and not field_aiming and facing!=joy_direction:
		set_combat_facing(joy_direction)
	joystick.queue_redraw()

func control_contains(control:Control,point:Vector2)->bool:
	return is_instance_valid(control) and control.is_visible_in_tree() and Rect2(Vector2.ZERO,control.size).has_point(control.get_global_transform_with_canvas().affine_inverse()*point)

func field_control_allowed(point:Vector2)->bool:
	if controls_modal() or notified or run.finished or tile_cast_active() or not control_contains(area,point):return false
	if control_contains(attack_button,point) or control_contains(map_zoom,point):return false
	if is_instance_valid(dev_bubble) and control_contains(dev_bubble,point):return false
	if map_expanded and control_contains(map,point):return false
	return true

func capture_field_aim(event:InputEvent)->bool:
	if not field_aim_enabled:return false
	var is_touch:bool=event is InputEventScreenTouch or event is InputEventScreenDrag
	var is_mouse:bool=event is InputEventMouseButton or event is InputEventMouseMotion
	if not is_touch and not is_mouse:return false
	if is_mouse and event.device==-1:return false
	var pointer:int=event.index if is_touch else -1
	var point:Vector2=event.position
	var down:bool=(event is InputEventScreenTouch and event.pressed) or (event is InputEventMouseButton and event.button_index==MOUSE_BUTTON_LEFT and event.pressed)
	var up:bool=(event is InputEventScreenTouch and not event.pressed) or (event is InputEventMouseButton and event.button_index==MOUSE_BUTTON_LEFT and not event.pressed)
	if pointer==field_pointer:
		var delta:Vector2=point-field_origin
		if up:
			field_pointer=-2
			var quick:bool=not field_aiming and delta.length()<12.0 and Time.get_ticks_msec()-field_started<220
			field_aiming=false;aim_preview.queue_redraw()
			if quick and not movement_joystick and field_control_allowed(point) and not (event is InputEventScreenTouch and event.canceled):
				world_tap(area.get_global_transform_with_canvas().affine_inverse()*point)
		elif (event is InputEventScreenDrag or event is InputEventMouseMotion) and delta.length()>12.0 and Time.get_ticks_msec()-field_started>=220 and field_control_allowed(point):
			field_aiming=true;path.clear();strike_pending=false
			set_combat_facing(Rules.aim8(delta))
		return true
	if down and field_pointer==-2 and not hold_active and native_aim_pointer==-2 and strike_pointer==-2 and field_control_allowed(point):
		if is_touch and pointer==0:native_touch_suppressed=true
		field_pointer=pointer;field_origin=point;field_started=Time.get_ticks_msec();field_aiming=false
		return true
	return false

func cancel_native_combat()->void:
	touch_feedback(native_move_button,false);touch_feedback(aim_button,false)
	if native_move_pointer!=-2:
		hold_active=false;hold_visible=false;hold_move={};hold_action=Callable()
		if is_instance_valid(hold_info):hold_info.hide()
	native_move_pointer=-2;native_aim_pointer=-2;native_move_button=null
	native_aim_dragged=false
	if is_instance_valid(aim_preview):aim_preview.queue_redraw()

func capture_native_combat(event:InputEvent)->bool:
	if event is InputEventMouseButton or event is InputEventMouseMotion:
		if event.device!=-1:return false
		if native_touch_suppressed:
			if event is InputEventMouseButton and not event.pressed:native_touch_suppressed=false
			return true
		return false
	if not (event is InputEventScreenTouch or event is InputEventScreenDrag):return false
	var point:Vector2=event.position
	var pointer:int=event.index
	var down:bool=event is InputEventScreenTouch and event.pressed
	var up:bool=event is InputEventScreenTouch and not event.pressed
	if pointer==native_move_pointer:
		if event is InputEventScreenDrag:
			var delta:=point-hold_origin
			if delta.length()>18.0:
				show_held_attack();set_combat_facing(Rules.aim8(delta));aim_preview.queue_redraw()
		elif up:
			var action:=hold_action
			var valid:bool=not event.canceled and is_instance_valid(native_move_button) and not native_move_button.disabled and native_move_button.is_visible_in_tree() and not controls_modal()
			cancel_native_combat()
			if valid and not notified and not run.finished and not tile_cast_active() and action.is_valid():action.call()
		return true
	if pointer==native_aim_pointer:
		if event is InputEventScreenDrag:
			var delta:=point-native_aim_origin
			if delta.length()>9.0:
				native_aim_dragged=true;set_combat_facing(Rules.aim8(delta));aim_preview.queue_redraw()
		elif up:
			var rotate:bool=not native_aim_dragged and not event.canceled and control_contains(aim_button,point)
			native_aim_pointer=-2;native_aim_dragged=false;touch_feedback(aim_button,false);aim_preview.queue_redraw()
			if rotate and not controls_modal():rotate_combat_aim()
		return true
	if down and pointer==0:native_touch_suppressed=false
	if not down or controls_modal() or notified or run.finished:return false
	if control_contains(aim_button,point):
		if pointer==0:native_touch_suppressed=true
		if native_aim_pointer==-2 and not hold_active and field_pointer==-2 and strike_pointer==-2 and not tile_cast_active():
			native_aim_pointer=pointer;native_aim_origin=point;native_aim_dragged=false;path.clear();strike_pending=false
			touch_feedback(aim_button,true);touch_haptic()
		return true
	for b in move_buttons:
		if not control_contains(b,point):continue
		if pointer==0:native_touch_suppressed=true
		if not b.disabled and not hold_active and not hold_release_pending and native_aim_pointer==-2 and field_pointer==-2 and strike_pointer==-2 and not tile_cast_active():
			native_move_pointer=pointer;native_move_button=b
			touch_feedback(b,true);touch_haptic()
			strike_pending=false;path.clear()
			hold_active=true;hold_visible=false;hold_age=0.0;hold_origin=point
			hold_move=b.get_meta("native_move");hold_action=b.get_meta("native_action");hold_is_dev=false
		return true
	return false

func capture_control_pointer(event:InputEvent)->bool:
	var is_touch:bool=event is InputEventScreenTouch or event is InputEventScreenDrag
	var is_mouse:bool=event is InputEventMouseButton or event is InputEventMouseMotion
	if not is_touch and not is_mouse:return false
	var point:Vector2=event.position
	var active:Button=panel_strike if strike_on_panel else attack_button
	if is_mouse and event.device==-1:
		# Only the primary touch's captured gesture may suppress its emulated mouse.
		# A second finger on the joystick must not swallow unrelated GUI input.
		return control_contains(joystick,point) or control_contains(active,point)
	var pointer:int=event.index if is_touch else -1
	var down:bool=(event is InputEventScreenTouch and event.pressed) or (event is InputEventMouseButton and event.button_index==MOUSE_BUTTON_LEFT and event.pressed)
	var up:bool=(event is InputEventScreenTouch and not event.pressed) or (event is InputEventMouseButton and event.button_index==MOUSE_BUTTON_LEFT and not event.pressed)
	var drag:bool=event is InputEventScreenDrag or event is InputEventMouseMotion
	if pointer==joy_pointer:
		if up:reset_joystick()
		elif drag:set_joystick_point(point)
		return true
	if pointer==strike_pointer:
		if drag and strike_touch_button==attack_button:
			var delta:=point-strike_touch_origin
			if delta.length()>9.0:strike_touch_moved=true
			if strike_touch_moved:
				strike_pending=false
				var transform:=area.get_global_transform_with_canvas().affine_inverse()
				var local_delta:Vector2=transform*point-transform*strike_touch_origin
				var travel:Vector2=(area.size-attack_button.size-Vector2(8,8)).max(Vector2.ZERO)
				attack_button.position=(strike_touch_start+local_delta).clamp(Vector2(4,4),Vector2(4,4)+travel)
		if up:
			strike_pointer=-2;touch_feedback(strike_touch_button,false)
			if event is InputEventScreenTouch and event.canceled:
				position_strike_bubble()
				strike_touch_moved=false;strike_touch_button=null
				return true
			if strike_touch_moved:
				var travel:Vector2=(area.size-attack_button.size-Vector2(8,8)).max(Vector2.ONE)
				strike_fraction=((attack_button.position-Vector2(4,4))/travel).clamp(Vector2.ZERO,Vector2.ONE)
				save_control_preferences()
			elif not (event is InputEventScreenTouch and event.canceled) and control_contains(strike_touch_button,point):
				request_strike()
		return true
	if controls_modal() or notified or run.finished:return false
	if down and control_contains(joystick,point):
		if is_touch and pointer==0:native_touch_suppressed=true
		if joy_pointer==-2:
			joy_pointer=pointer;path.clear();strike_pending=false;set_joystick_point(point);tick=0.0
		return true
	if down and control_contains(active,point):
		if is_touch and pointer==0:native_touch_suppressed=true
		if strike_pointer==-2 and not hold_active and native_aim_pointer==-2 and field_pointer==-2 and strike_available():
			strike_pointer=pointer;strike_touch_button=active;strike_touch_origin=point;strike_touch_moved=false;strike_touch_start=active.position
			touch_feedback(active,true);touch_haptic()
		return true
	return false

func strike_buffer_valid(direction:Vector2i,floor_id:int,current_floor:int)->bool:
	return direction in Rules.DIR8 and floor_id==current_floor

func request_strike()->void:
	if utility_drag_suppress or hold_active or hold_release_pending or native_aim_pointer!=-2 or field_pointer!=-2 or not strike_available():return
	path.clear()
	if attack_time>0.0:
		strike_pending=true;strike_buffer_direction=facing;strike_buffer_floor=run.floor_revision
		return
	strike_pending=false;strike_buffer_direction=Vector2i.ZERO;strike_buffer_floor=-1
	var acted:bool=run.attack(false,facing)
	sync()
	# A whiff swings without inventing damage, PP use or a turn.
	if not acted and not run.finished:
		begin_player_cast_pose({"fx":"basic_strike","from":run.player,"to":run.player+facing})
		empty_strike_pose=true
		if is_instance_valid(attack_fx):attack_fx.hide()

func position_strike_bubble()->void:
	if not is_instance_valid(attack_button):return
	var travel:Vector2=(area.size-attack_button.size-Vector2(8,8)).max(Vector2.ZERO)
	attack_button.position=Vector2(4,4)+travel*strike_fraction

func utility_drag_input(event:InputEvent,kind:String)->void:
	if event is InputEventMouseButton and event.button_index==MOUSE_BUTTON_LEFT and event.pressed and not hold_active:
		utility_drag_kind=kind;utility_drag_moved=false;utility_drag_suppress=false
		var source:Control=aim_button if kind=="aim" else attack_button
		utility_drag_origin=source.get_global_transform_with_canvas()*event.position
		utility_drag_start=attack_button.position
func reset_utility_drag()->void:
	utility_drag_suppress=false
func handle_utility_drag(event:InputEvent)->bool:
	if utility_drag_kind.is_empty():return false
	if event is InputEventMouseMotion:
		var delta:Vector2=event.position-utility_drag_origin
		if delta.length()>9.0:utility_drag_moved=true
		if utility_drag_moved:
			utility_drag_suppress=true
			strike_pending=false
			if utility_drag_kind=="aim":
				path.clear();set_combat_facing(Rules.aim8(delta));aim_preview.queue_redraw()
			else:
				var travel:Vector2=(area.size-attack_button.size-Vector2(8,8)).max(Vector2.ZERO)
				attack_button.position=(utility_drag_start+delta).clamp(Vector2(4,4),Vector2(4,4)+travel)
			return true
	elif event is InputEventMouseButton and event.button_index==MOUSE_BUTTON_LEFT and not event.pressed:
		if utility_drag_moved and utility_drag_kind=="strike":
			var travel:Vector2=(area.size-attack_button.size-Vector2(8,8)).max(Vector2.ONE)
			strike_fraction=((attack_button.position-Vector2(4,4))/travel).clamp(Vector2.ZERO,Vector2.ONE)
			var prefs:=ConfigFile.new();prefs.load("user://kindria_hud.cfg")
			prefs.set_value("combat","strike_position",strike_fraction);prefs.save("user://kindria_hud.cfg")
		utility_drag_kind="";utility_drag_moved=false
		aim_preview.queue_redraw()
		reset_utility_drag.call_deferred()
	return false

func build_bag()->void:
	bag_panel=PanelContainer.new();bag_panel.add_theme_stylebox_override("panel",compact_style(hud_base_color(),hud_accent_color(),12))
	area.add_child(bag_panel);bag_panel.z_index=30
	bag_panel.set_anchor(SIDE_LEFT,.08);bag_panel.set_anchor(SIDE_RIGHT,.92)
	bag_panel.set_anchor(SIDE_TOP,.12);bag_panel.set_anchor(SIDE_BOTTOM,.86)
	bag_panel.set_offset(SIDE_LEFT,0);bag_panel.set_offset(SIDE_RIGHT,0);bag_panel.set_offset(SIDE_TOP,0);bag_panel.set_offset(SIDE_BOTTOM,0)
	var stack:=VBoxContainer.new();bag_panel.add_child(stack)
	var heading:=HBoxContainer.new();stack.add_child(heading)
	var title:=label(heading,"Bag",16,hud_accent_color());title.size_flags_horizontal=SIZE_EXPAND_FILL
	var close:=lab_button(heading,"×",func():bag_panel.hide());close.size_flags_horizontal=SIZE_SHRINK_END
	var scroll:=ScrollContainer.new();scroll.size_flags_vertical=SIZE_EXPAND_FILL;scroll.horizontal_scroll_mode=ScrollContainer.SCROLL_MODE_DISABLED;stack.add_child(scroll)
	bag_content=VBoxContainer.new();bag_content.size_flags_horizontal=SIZE_EXPAND_FILL;scroll.add_child(bag_content)
	bag_panel.hide()
func toggle_bag()->void:
	if bag_panel.visible:bag_panel.hide();return
	path.clear();strike_pending=false;reset_joystick();cancel_native_combat()
	touch_feedback(strike_touch_button,false);strike_touch_button=null;strike_pointer=-2
	refresh_bag();bag_panel.show()
func clear_bag_content()->void:
	for child in bag_content.get_children():
		bag_content.remove_child(child);child.queue_free()
func refresh_bag()->void:
	clear_bag_content()
	label(bag_content,"Supplies",14,hud_accent_color())
	var berry:=lab_button(bag_content,"Berry ×%d"%run.potions,func():run.heal();sync();refresh_bag())
	berry.disabled=run.potions<=0 or run.hp>=run.max_hp
	label(bag_content,"Materials: %d"%run.materials,13)
	label(bag_content,"Held: "+(run.held_item.replace("_"," ").capitalize() if not run.held_item.is_empty() else "None"),13)
	label(bag_content,"Technique manuals",14,hud_accent_color())
	var available:=Rules.available_moves(run.trained_profile.get("types",["normal"]),int(run.trained_profile.get("level",1)))
	if run.technique_manuals.is_empty():label(bag_content,"No manuals collected",12)
	for entry in run.technique_manuals:
		var id:String=str(entry)
		if not Rules.MOVE_LIBRARY.has(id):continue
		var teach:=lab_button(bag_content,"%s ×%d"%[Rules.MOVE_LIBRARY[id].name,run.technique_manuals[id]],bag_choose_move.bind(id))
		teach.disabled=id in run.equipped_moves or not id in available
func bag_choose_move(id:String)->void:
	if run.equipped_moves.size()<4:
		if run.learn_from_manual(id):update_hud()
		refresh_bag();return
	clear_bag_content()
	label(bag_content,"Replace a move with "+str(Rules.MOVE_LIBRARY[id].name),14,hud_accent_color())
	for entry in run.equipped_moves:
		var old:String=str(entry)
		lab_button(bag_content,str(Rules.MOVE_LIBRARY[old].name),bag_replace_move.bind(id,old))
	lab_button(bag_content,"Cancel",refresh_bag)
func bag_replace_move(id:String,old:String)->void:
	if run.learn_from_manual(id,old):update_hud()
	refresh_bag()
func leave():
	if notified:return
	strike_pending=false
	notified=true
	call_deferred("emit_cancel")
func emit_cancel():
	canceled.emit()
func pos(p:Vector2i)->Vector3:
	return Vector3(p.x*1.4,0,p.y*1.4)
func mat(c:Color)->StandardMaterial3D:
	if not mats.has(c):
		var m=StandardMaterial3D.new();m.albedo_color=c;m.roughness=.8;mats[c]=m
	return mats[c]
func build_terrain_textures():
	# Periodic hand-laid paving: irregular joints and regional surface accents.
	var size_px=128
	var img=Image.create(size_px,size_px,false,Image.FORMAT_RGBA8)
	var normals=Image.create(size_px,size_px,false,Image.FORMAT_RGBA8)
	var noise=FastNoiseLite.new();noise.seed=146+region*97;noise.frequency=.045;noise.fractal_octaves=3
	var heights:PackedFloat32Array=[];heights.resize(size_px*size_px)
	for y in range(size_px):
		for x in range(size_px):
			var u=float(x)/size_px;var w=float(y)/size_px
			var h0=lerpf(noise.get_noise_2d(x,y),noise.get_noise_2d(x-size_px,y),u)
			var h1=lerpf(noise.get_noise_2d(x,y-size_px),noise.get_noise_2d(x-size_px,y-size_px),u)
			var h=lerpf(h0,h1,w)
			var color:Color
			var relief=0.0
			if region==0:
				# Mossy woodland soil: broad irregular patches, flecks of leaf litter, no brick grid.
				var patch=smoothstep(-.52,.52,h)
				var fine=float(posmod(x*73+y*137+x*y*19,101))/100.0
				var grain=.5+.5*sin(u*TAU*19.0+sin(w*TAU*13.0)*2.0)
				color=Color(.65,.59,.42).lerp(Color(.73,.77,.52),patch)
				color=color.lerp(Color(.58,.65,.39),smoothstep(.26,.55,h)*.22)
				color=color.darkened((grain*.035+fine*.045))
				relief=h*.048+grain*.006+fine*.005
			elif region==1:
				# Seabed sandstone: crossing ripples and light caustics, no masonry.
				var ripple=sin(w*TAU*8.0+sin(u*TAU*2.0)*1.45+sin((u+w)*TAU)*1.2)
				var secondary=sin((u-w)*TAU*5.0+sin(w*TAU*2.0)*1.4)
				var fine=float(posmod(x*103+y*59+x*y*17,113))/112.0
				var ridge=smoothstep(.24,.95,ripple)*.75+smoothstep(.64,.99,secondary)*.25
				# Sandy beds use warm mineral grains and cool troughs; caustics
				# remain in the separate animated lighting overlay.
				color=Color(.50,.65,.69).lerp(Color(.87,.92,.78),clampf(.50+h*.72+ridge*.28,0.0,1.0))
				color=color.darkened(fine*.055)
				relief=h*.055+ridge*.048+fine*.004
			else:
				# Astral ruin: broken rectangular slabs and restrained brass tracery.
				var py=w*2.0+sin(u*TAU)*.045
				var px=u*2.0+floorf(py)*.5+sin(w*TAU*2.0)*.04
				var edge=minf(minf(fposmod(px,1.0),1.0-fposmod(px,1.0)),minf(fposmod(py,1.0),1.0-fposmod(py,1.0)))
				var stone=smoothstep(.012,.045,edge)
				var shade=.71+.13*sin(floorf(px)*2.1+floorf(py)*1.7)+h*.23
				color=Color(.28,.26,.38).lerp(Color(shade,shade,shade),stone)
				var line=1.0-smoothstep(.008,.022,absf(edge-.10))
				color=color.lerp(Color(.82,.65,.37),line*.19)
				relief=stone*.12+h*.07
			img.set_pixel(x,y,color)
			heights[y*size_px+x]=relief
	# Periodic authored leaf stamps: organic pointed shapes with a midrib,
	# not a repeated sine-wave pattern. Wrap both axes for seamless mipmaps.
	if region==0:stamp_woodland_litter(img,heights,size_px)
	for y in range(size_px):
		for x in range(size_px):
			var dx=heights[y*size_px+posmod(x+1,size_px)]-heights[y*size_px+posmod(x-1,size_px)]
			var dy=heights[posmod(y+1,size_px)*size_px+x]-heights[posmod(y-1,size_px)*size_px+x]
			var n=Vector3(-dx*2.6,-dy*2.6,1).normalized()
			normals.set_pixel(x,y,Color(n.x*.5+.5,n.y*.5+.5,n.z*.5+.5,1))
	img.generate_mipmaps();normals.generate_mipmaps()
	terrain_texture=ImageTexture.create_from_image(img);terrain_normal=ImageTexture.create_from_image(normals)
	floor_surface_signature=img.get_data().hex_encode().sha256_text()
func stamp_woodland_litter(img:Image,heights:PackedFloat32Array,size_px:int):
	var rng=RandomNumberGenerator.new();rng.seed=48381
	for i in range(54):
		var cx=rng.randi_range(0,size_px-1);var cy=rng.randi_range(0,size_px-1)
		var angle=rng.randf_range(0,TAU)
		var axis=Vector2(cos(angle),sin(angle));var across=Vector2(-axis.y,axis.x)
		var length=rng.randf_range(2.5,5.6);var width=rng.randf_range(1.0,2.2)
		var tint=Color(.66,.37,.15).lerp(Color(.89,.67,.27),rng.randf())
		for dy in range(-7,8):
			for dx in range(-7,8):
				var offset=Vector2(dx,dy)
				var along=offset.dot(axis)/length;var side=offset.dot(across)/width
				var silhouette=absf(along)+side*side
				if silhouette>=1.0:continue
				var x=posmod(cx+dx,size_px);var y=posmod(cy+dy,size_px)
				var alpha=(1.0-smoothstep(.65,1.0,silhouette))*.75
				var vein=1.0-smoothstep(.06,.33,absf(side))
				img.set_pixel(x,y,img.get_pixel(x,y).lerp(tint.lightened(vein*.18),alpha))
				heights[y*size_px+x]+=.018*alpha
func terrain_mat(c:Color)->StandardMaterial3D:
	if terrain_mats.has(c):return terrain_mats[c]
	var m=StandardMaterial3D.new();m.albedo_color=c;m.albedo_texture=terrain_texture;m.roughness=.84
	m.normal_enabled=true;m.normal_texture=terrain_normal;m.normal_scale=.42
	m.uv1_triplanar=true;m.uv1_world_triplanar=true;m.uv1_scale=Vector3.ONE*(.26 if region==0 else .32 if region==1 else .43)
	terrain_mats[c]=m
	return m
func mesh(kind:String)->Mesh:
	if not meshes.has(kind):
		match kind:
			"box":meshes[kind]=BoxMesh.new()
			"gem":meshes[kind]=PrismMesh.new()
			"orb":meshes[kind]=SphereMesh.new()
			"ring":meshes[kind]=TorusMesh.new()
	return meshes[kind]
func shape(parent:Node3D,kind:String,p:Vector3,scale_value:Vector3,c:Color)->MeshInstance3D:
	var o=MeshInstance3D.new();o.mesh=mesh(kind);o.material_override=mat(c);parent.add_child(o);o.position=p;o.scale=scale_value
	return o
func model(parent:Node3D,id:int)->Node3D:
	var node=Node3D.new();parent.add_child(node)
	if PixelArt.world_sprite(node,id)!=null:
		node.scale=Vector3.ONE*.70
