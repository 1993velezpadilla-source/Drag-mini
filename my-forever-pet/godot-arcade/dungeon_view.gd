	var vertices:Dictionary={}
	for p in run.cells:
		for y in range(2):
			for x in range(2):
				var origin:Vector2i=p*2+Vector2i(x-1,y-1)
				var corners=[origin,origin+Vector2i.RIGHT,origin+Vector2i(1,1),origin+Vector2i.DOWN]
				var ids:PackedInt32Array=[]
