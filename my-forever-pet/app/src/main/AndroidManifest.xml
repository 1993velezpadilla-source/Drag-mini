<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.RECORD_AUDIO"/>
 <uses-feature android:name="android.hardware.microphone" android:required="false"/>
 <uses-feature android:name="android.software.live_wallpaper" android:required="false"/>
 <application android:label="My Forever Pet" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false">
  <activity android:name=".MainActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
  <service android:name=".PetWallpaper" android:label="My Forever Pet" android:permission="android.permission.BIND_WALLPAPER" android:exported="true">
   <intent-filter><action android:name="android.service.wallpaper.WallpaperService"/></intent-filter>
   <meta-data android:name="android.service.wallpaper" android:resource="@xml/pet_wallpaper"/>
  </service>
 </application>
</manifest>
