extends SceneTree
## REAL native Godot frame of each original CC0 vehicle in a 6-source batch.
## Imported Blender-GLB only; validates against invisible-source-mesh control.
## No screenshots generated by AI. Do NOT claim gameplay-ready cars here.

func _initialize() -> void:
    call_deferred("_run")

func _bad(msg: String) -> void:
    push_error("CITYZERO_CC0_ORIGINAL_GODOT_QA_RED: " + msg)
    quit(1)

func _meshes(node: Node, output: Array[MeshInstance3D]) -> void:
    if node is MeshInstance3D and node.mesh != null:
        output.append(node as MeshInstance3D)
    for n in node.get_children():
        _meshes(n, output)

func _frame(viewport: SubViewport) -> Image:
    await RenderingServer.frame_post_draw
    return viewport.get_texture().get_image()

func _run() -> void:
    var source := FileAccess.get_file_as_string("res://real_cc0_source_vehicle_audit/downloaded_original_cc0_vehicle_batch.json")
    var manifest = JSON.parse_string(source)
    if not (manifest is Dictionary) or not manifest.has("models"):
        _bad("Missing REAL source SHA256 manifest")
        return
    var dest := OS.get_environment("CITYZERO_REAL_CC0_GODOT_SHOTS")
    if dest.is_empty():
        dest = ProjectSettings.globalize_path("user://tevy-real-source-game-views")
    DirAccess.make_dir_recursive_absolute(dest)
    var verified: Array[Dictionary] = []
    for item in manifest["models"]:
        var name: String = item["id"]
        var path: String = "res://assets/tevy_cc0_blender_vehicles/" + name + "_real_import.glb"
        var packed: PackedScene = load(path)
        if packed == null:
            _bad("Original Blender GLB fails Godot import " + name)
            return
        var viewport := SubViewport.new()
        viewport.size = Vector2i(1200, 800)
        viewport.transparent_bg = false
        viewport.render_target_update_mode = SubViewport.UPDATE_ALWAYS
        root.add_child(viewport)
        var car := packed.instantiate() as Node3D
        if car == null:
            _bad("Expected real 3D source root " + name)
            return
        viewport.add_child(car)
        var actual: Array[MeshInstance3D] = []
        _meshes(car, actual)
        if actual.is_empty():
            _bad("Authentic source rendered no meshes " + name)
            return
        var low := Vector3(INF, INF, INF)
        var high := Vector3(-INF, -INF, -INF)
        var tris: int = 0
        for obj in actual:
            var m: Mesh = obj.mesh
            for surface in range(m.get_surface_count()):
                if m.surface_get_primitive_type(surface) != Mesh.PRIMITIVE_TRIANGLES:
                    continue
                var indices: int = m.surface_get_array_index_len(surface)
                tris += int((indices if indices > 0 else m.surface_get_array_len(surface)) / 3)
            for corner in range(8):
                var p: Vector3 = obj.global_transform * m.get_aabb().get_endpoint(corner)
                low = low.min(p)
                high = high.max(p)
        var src_tris: int = int(item["author_declared_triangles_lod0"])
        if tris < 6000 or absf(float(tris - src_tris)) > float(src_tris) * .2:
            _bad("Imported geometry source triangle mismatch " + name)
            return
        var mid := (low + high) * .5
        var ext := high - low
        var span := maxf(ext.x, maxf(ext.y, ext.z))
        if span < 0.35 or span > 150:
            _bad("Model import size broken " + name)
            return

        var env := WorldEnvironment.new()
        env.environment = Environment.new()
        env.environment.background_mode = Environment.BG_COLOR
        env.environment.background_color = Color(0.13, .18, .25)
        env.environment.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
        env.environment.ambient_light_color = Color(.82, .85, .91)
        env.environment.ambient_light_energy = .8
        viewport.add_child(env)
        var light := DirectionalLight3D.new()
        light.rotation_degrees = Vector3(-49, 35, -14)
        light.light_energy = 2.2
        viewport.add_child(light)
        var camera := Camera3D.new()
        camera.projection = Camera3D.PROJECTION_ORTHOGONAL
        camera.size = span * 1.7
        camera.position = mid + Vector3(1.2, .53, 1.4) * span
        viewport.add_child(camera)
        camera.look_at(mid, Vector3.UP)
        camera.current = true
        for frame in range(20):
            await process_frame
        var photo := await _frame(viewport)
        if photo == null or photo.is_empty():
            _bad("No actual Godot viewport image " + name)
            return
        for obj in actual:
            obj.visible = false
        for frame in range(5):
            await process_frame
        var hidden := await _frame(viewport)
        for obj in actual:
            obj.visible = true
        if hidden == null or hidden.is_empty():
            _bad("No source-invisible control screenshot " + name)
            return
        var changed: int = 0
        for y in range(80, 720, 5):
            for x in range(100, 1100, 5):
                var a := photo.get_pixel(x,y)
                var b := hidden.get_pixel(x,y)
                if absf(a.r-b.r)+absf(a.g-b.g)+absf(a.b-b.b) > .16:
                    changed += 1
        if changed < 120:
            _bad("The imported source geometry was NOT visible in Godot " + name + " pixels " + str(changed))
            return
        var imagepath := dest.path_join(name + "_REAL_GODOT_CC0_SOURCE.png")
        if photo.save_png(imagepath) != OK:
            _bad("Could not save original source Godot frame " + name)
            return
        verified.append({"id":name,"source_sha256":item["sha256"],"native_godot_triangles":tris,
            "rendered_mesh_instances":actual.size(),"verified_car_visible_pixel_samples":changed,
            "godot_png":imagepath,"game_ready":false,"needs_visual_approval":true})
        viewport.queue_free()
        await process_frame
        print("REAL_CC0_GODOT_SOURCE_GLTF_RENDER_VERIFIED ", name, " tris=", tris, " changed=", changed)

    var f := FileAccess.open(dest.path_join("real_cc0_godot_batch_report.json"), FileAccess.WRITE)
    if f == null:
        _bad("Cannot save original source renderer proof")
        return
    f.store_string(JSON.stringify(verified, "  "))
    f.close()
    if verified.size() == 0:
        _bad("No original vehicles imported")
        return
    print("CITY_ZERO_ORIGINAL_CC0_GODOT_BATCH_GREEN ", verified.size())
    quit(0)
